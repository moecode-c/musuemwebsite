<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<section class="page-hero">
  <div class="container">
    <h1><%= heroTitle || t.exhibits.allTitle %></h1>
    <p><%= heroSubtitle || t.exhibits.allSubtitle %></p>
  </div>
</section>

<section class="section exhibits-timeline-section collection-<%= collectionKey || 'all' %>">
  <div class="container">
    <div class="timeline-heading">
      <h2><%= heroTitle || t.exhibitCollection.timeline %> <%= t.exhibitCollection.timeline %></h2>
      <p><%= t.exhibitCollection.timelineSubtitle %></p>
    </div>
    <% if ((timelineItems || []).length === 0) { %>
    <div class="timeline-empty">
      <h3><%= t.exhibitCollection.timelineComingSoon %></h3>
      <p><%= t.exhibitCollection.timelineComingSoonText %></p>
    </div>
    <% } else { %>
    <div class="timeline" aria-label="<%= t.exhibitCollection.timeline %>">
      <% (timelineItems || []).forEach((timeline, index) => { %>
      <%- include('../partials/timelineCard', { timeline, index }) %>
      <% }) %>
    </div>
    <% } %>
  </div>
</section>

<section class="section exhibits-artifacts-section collection-<%= collectionKey || 'all' %>">
  <div class="container">
    <% if ((artifactItems || []).length === 0) { %>
    <div class="timeline-empty grid-empty">
      <h3><%= t.exhibitCollection.noExhibits %></h3>
      <p><%= t.exhibitCollection.noExhibitsText %></p>
    </div>
    <% } else { %>
    <div class="artifact-showcase-title"><span><%= (heroTitle || t.exhibits.allTitle).toUpperCase() %> <%= t.exhibitCollection.artifacts %></span></div>
    <div class="artifact-grid">
      <% artifactItems.forEach((card) => { %>
      <%- include('../partials/artifactCard', { card }) %>
      <% }) %>
    </div>
    <% } %>
    <%- paginationHtml %>
  </div>
</section>

<%- include('../partials/footer') %>