<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<section class="page-hero">
  <div class="container">
    <h1><%= exhibit.title %></h1>
    <p><%= exhibit.category %> | <%= exhibit.era %></p>
  </div>
</section>

<section class="section">
  <div class="container split">
    <div>
      <img src="<%= exhibit.imageUrl %>" alt="<%= exhibit.title %>" class="detail-image" />
      <p><%= exhibit.description %></p>
      <% if (exhibit.x !== null && exhibit.x !== undefined && exhibit.y !== null && exhibit.y !== undefined) { %>
        <a class="btn" href="/location?x=<%= exhibit.x %>&y=<%= exhibit.y %>&label=<%= encodeURIComponent(exhibit.title) %>&description=<%= encodeURIComponent(exhibit.category) %>">View on Map</a>
      <% } %>
    </div>
    <div>
      <model-viewer
        src="<%= exhibit.modelUrl %>"
        alt="3D model of <%= exhibit.title %>"
        auto-rotate
        camera-controls
        class="model-viewer">
      </model-viewer>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
