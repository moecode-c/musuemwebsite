<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<section class="page-hero">
  <div class="container">
    <h1><%= exhibit.title %></h1>
    <p><%= exhibit.category %> | <%= exhibit.era || t.exhibitDetail.ancientEgypt %></p>
  </div>
</section>

<section class="section exhibit-detail-section">
  <div class="container">
    <article class="exhibit-detail-shell">
      <div class="exhibit-detail-content">
        <h2><%= exhibit.title %></h2>
        <p class="exhibit-detail-description"><%= exhibit.description || t.exhibitDetail.noDescription %></p>
        <% if (eraInfo) { %>
        <p class="exhibit-detail-era-info"><strong><%= t.exhibitDetail.eraInsight %>:</strong> <%= eraInfo %></p>
        <% } %>
        <% if (eraExtras && (eraExtras.significance || eraExtras.legacy)) { %>
        <div class="exhibit-detail-era-extra">
          <% if (eraExtras.significance) { %>
          <p><strong><%= t.exhibitDetail.historicalSignificance %>:</strong> <%= eraExtras.significance %></p>
          <% } %>
          <% if (eraExtras.legacy) { %>
          <p><strong><%= t.exhibitDetail.legacy %>:</strong> <%= eraExtras.legacy %></p>
          <% } %>
        </div>
        <% } %>
        <ul class="exhibit-detail-meta">
          <% if (exhibit.category) { %><li><strong><%= t.exhibitDetail.type %>:</strong> <span><%= exhibit.category %></span></li><% } %>
          <% if (exhibit.period || exhibit.era) { %><li><strong><%= t.exhibitDetail.period %>:</strong> <span><%= exhibit.period || exhibit.era %></span></li><% } %>
          <% if (exhibit.location) { %><li><strong><%= t.exhibitDetail.origin %>:</strong> <span><%= exhibit.location %></span></li><% } %>
        </ul>
        <div class="exhibit-detail-actions">
          <a class="btn artifact-btn" href="<%= backHref || '/exhibits' %>"><%= t.exhibitDetail.backToExhibits %></a>
          <% if (exhibit.x !== null && exhibit.x !== undefined && exhibit.y !== null && exhibit.y !== undefined) { %>
          <a class="btn artifact-btn" href="/location?x=<%= exhibit.x %>&y=<%= exhibit.y %>&label=<%= encodeURIComponent(exhibit.title) %>&description=<%= encodeURIComponent(exhibit.category) %>"><%= t.exhibitDetail.viewOnMap %></a>
          <% } %>
        </div>
      </div>
      <div class="exhibit-detail-model-wrap">
        <% if (exhibit.modelUrl) { %>
        <model-viewer src="<%= exhibit.modelUrl %>" alt="<%= exhibit.title %>" auto-rotate camera-controls class="model-viewer"></model-viewer>
        <% } else { %>
        <p class="timeline-empty"><%= t.exhibitDetail.noModel %></p>
        <% } %>
      </div>
    </article>
  </div>
</section>

<%- include('../partials/footer') %>