<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<section class="section exhibit-detail-section">
  <div class="container">
    <article class="exhibit-spotlight-shell">
      <figure class="exhibit-spotlight-media" aria-label="Artifact image">
        <img src="<%= detailImageUrl || exhibit.imageUrl %>" alt="<%= exhibit.title %>" loading="lazy" onerror="this.onerror=null;this.src='/assets/images/pillarsbg.png';" />
      </figure>

      <div class="exhibit-spotlight-content" aria-label="Artifact information">
        <h1><%= exhibit.title %></h1>
        <p class="exhibit-spotlight-intro"><%= exhibit.description || "No description available for this artifact yet." %></p>

        <div class="exhibit-spotlight-meta" aria-label="Artifact details">
          <% if (exhibit.category) { %>
          <p><strong>Type:</strong> <span><%= exhibit.category %></span></p>
          <% } %>
          <% if (exhibit.period || exhibit.era) { %>
          <p><strong>Period:</strong> <span><%= exhibit.period || exhibit.era %></span></p>
          <% } %>
          <% if (exhibit.location) { %>
          <p><strong>Origin:</strong> <span><%= exhibit.location %></span></p>
          <% } %>
        </div>

        <% if (eraInfo) { %>
        <p class="exhibit-spotlight-body"><%= eraInfo %></p>
        <% } %>
        <% if (eraExtras && (eraExtras.significance || eraExtras.legacy)) { %>
        <p class="exhibit-spotlight-body">
          <%= eraExtras.significance || "" %>
          <%= eraExtras.legacy ? ` ${eraExtras.legacy}` : "" %>
        </p>
        <% } %>

        <div class="exhibit-detail-actions">
          <% if (exhibit.modelUrl) { %>
          <a class="btn exhibit-spotlight-btn" href="/exhibits/artifactPopup?id=<%= exhibit._id %>">Explore Artifact</a>
          <% } %>
           <a class="btn exhibit-spotlight-link" href="<%= backHref || '/exhibits' %>">Back to Exhibits</a>
           <% if (exhibit.x !== null && exhibit.x !== undefined && exhibit.y !== null && exhibit.y !== undefined) { %>
           <a class="btn exhibit-spotlight-link" href="/location?x=<%= exhibit.x %>&y=<%= exhibit.y %>&label=<%= encodeURIComponent(exhibit.title) %>&description=<%= encodeURIComponent(exhibit.category) %>">View on Map</a>
           <% } %>
        </div>
      </div>
    </article>
  </div>
</section>

<%- include('../partials/footer') %>
