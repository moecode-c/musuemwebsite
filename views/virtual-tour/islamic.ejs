<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<section class="tour-hero" id="tourinfo">
  <div class="container">
    <h1 class="tour-title">Islamic Virtual Tour</h1>
    <p class="tour-subtitle">
      Explore Islamic art, architecture, and historical treasures through a guided virtual experience.
    </p>
  </div>
</section>

<section class="tour-intro">
  <div class="container">
    <h2>Welcome</h2>
    <p>
      Discover the legacy of Islamic civilization with immersive panoramas, curated artifacts,
      and interactive highlights. Use the controls to navigate, listen to audio commentary, and
      download the tour brochure.
    </p>
  </div>
</section>

<section class="tour-map">
  <div class="container">
    <div class="map-frame">
      <iframe
        title="Islamic Virtual Tour"
        src="https://www.google.com/maps/embed?pb=!4v1756509146609!6m8!1m7!1sIdzjvtjfHTwF6xW5unYS8w!2m2!1d25.29564881538289!2d51.53934068111935!3f279.5574869588035!4f-11.930292460529216!5f0.7820865974627469"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
      <div class="map-ornament ornament-1"></div>
      <div class="map-ornament ornament-2"></div>
      <div class="map-ornament ornament-3"></div>
      <div class="map-ornament ornament-4"></div>
    </div>
    <div class="tour-controls">
      <button class="btn tour-btn" id="tour-audio-btn"><i class="fas fa-volume-up"></i>Audio Guide</button>
      <a class="btn tour-btn" href="/assets/brochure.pdf" download>
        <i class="fas fa-file-arrow-down"></i>Download Brochure
      </a>
      <a class="btn tour-btn" href="#tourinfo"><i class="fas fa-info-circle"></i>Tour Info</a>
      <button class="btn tour-btn" id="tour-fullscreen-btn"><i class="fas fa-expand"></i>Fullscreen</button>
    </div>
  </div>
</section>

<section class="tour-info">
  <div class="container">
    <h3>Tour Notes</h3>
    <p>
      For the best experience, use headphones and explore each panorama point to reveal hidden
      details about artifacts, architectural motifs, and historical narratives.
    </p>
    <audio id="tour-audio" src="/assets/audio/islamic-tour.mp3"></audio>
  </div>
</section>

<%- include('../partials/footer') %>
