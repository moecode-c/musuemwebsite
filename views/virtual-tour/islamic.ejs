<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<section class="tour-hero tour-hero--islamic" id="tourinfo">
  <div class="container">
    <article class="tour-hero-card">
      <p class="tour-kicker">360 Immersive Route</p>
      <h1 class="tour-title"><%= t.virtualTour.islamicTitle %></h1>
      <p class="tour-subtitle"><%= t.virtualTour.islamicHeroSubtitle %></p>
      <div class="tour-hero-actions">
        <a class="btn tour-hero-btn-primary" href="#tour-map">Enter Live Tour</a>
        <a class="btn tour-hero-btn-ghost" href="#tour-notes">Read Notes</a>
      </div>
    </article>
  </div>
</section>

<section class="tour-intro">
  <div class="container">
    <h2><%= t.virtualTour.islamicWelcome %></h2>
    <p><%= t.virtualTour.islamicIntro %></p>
  </div>
</section>

<section class="tour-map" id="tour-map">
  <div class="container">
    <header class="tour-map-heading">
      <h3>Interactive Route</h3>
      <p>Navigate the selected site in real time, then switch to fullscreen for a museum-like viewing mode.</p>
    </header>

    <div class="map-frame">
      <iframe
        title="<%= t.virtualTour.islamicTitle %>"
        src="https://www.google.com/maps/embed?pb=!4v1756509146609!6m8!1m7!1sIdzjvtjfHTwF6xW5unYS8w!2m2!1d25.29564881538289!2d51.53934068111935!3f279.5574869588035!4f-11.930292460529216!5f0.7820865974627469"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
      <div class="map-ornament ornament-1"></div>
      <div class="map-ornament ornament-2"></div>
      <div class="map-ornament ornament-3"></div>
      <div class="map-ornament ornament-4"></div>
    </div>
    <div class="tour-controls">
      <button class="btn tour-btn" id="tour-fullscreen-btn" type="button"><i class="fas fa-expand"></i><%= t.virtualTour.fullscreen %></button>
      <a class="btn tour-btn" href="#tourinfo"><i class="fas fa-info-circle"></i><%= t.virtualTour.tourInfo %></a>
      <a class="btn tour-btn" href="/assets/Afterlife-museum-brochure.pdf" download="Afterlife-museum-brochure.pdf">
        <i class="fas fa-file-arrow-down"></i><%= t.virtualTour.downloadBrochure %>
      </a>
      <button class="btn tour-btn" id="tour-audio-btn" type="button" aria-label="Toggle audio guide"><i class="fas fa-volume-up"></i><%= t.virtualTour.audioGuide %></button>
    </div>
  </div>
</section>

<section class="tour-info" id="tour-notes">
  <div class="container">
    <h3><%= t.virtualTour.tourNotesTitle %></h3>
    <p><%= t.virtualTour.islamicTourNotesText %></p>
    <audio id="tour-audio" src="/audio/islamicVirtualaudio.mp3" preload="metadata"></audio>
  </div>
</section>

<%- include('../partials/footer') %>
