<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<section class="tour-hero" id="tourinfo">
  <div class="container">
    <h1 class="tour-title"><%= t.virtualTour.heroTitle %></h1>
    <p class="tour-subtitle"><%= t.virtualTour.christianHeroSubtitle %></p>
  </div>
</section>

<section class="tour-intro">
  <div class="container">
    <h2><%= t.virtualTour.christianWelcome %></h2>
    <p><%= t.virtualTour.christianIntro %></p>
  </div>
</section>

<section class="tour-map">
  <div class="container">
    <div class="map-frame">
      <iframe
        title="<%= t.virtualTour.christianTitle %>"
        src="https://www.google.com/maps/embed?pb=!4v1756514091656!6m8!1m7!1sKxGiVsq4lyvQfLGofekgrQ!2m2!1d45.45452731239332!2d9.181193583672036!3f169.97287295006342!4f0.3149009128870546!5f0.7820865974627469"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
      <div class="map-ornament ornament-1"></div>
      <div class="map-ornament ornament-2"></div>
      <div class="map-ornament ornament-3"></div>
      <div class="map-ornament ornament-4"></div>
    </div>
    <div class="tour-controls">
      <button class="btn tour-btn" id="tour-fullscreen-btn"><i class="fas fa-expand"></i><%= t.virtualTour.fullscreen %></button>
      <a class="btn tour-btn" href="#tourinfo"><i class="fas fa-info-circle"></i><%= t.virtualTour.tourInfo %></a>
      <a class="btn tour-btn" href="/assets/brochure.pdf" download>
        <i class="fas fa-file-arrow-down"></i><%= t.virtualTour.downloadBrochure %>
      </a>
      <button class="btn tour-btn" id="tour-audio-btn"><i class="fas fa-volume-up"></i><%= t.virtualTour.audioGuide %></button>
    </div>
  </div>
</section>

<section class="tour-info">
  <div class="container">
    <h3><%= t.virtualTour.tourNotesTitle %></h3>
    <p><%= t.virtualTour.christianTourNotesText %></p>
    <audio id="tour-audio" src="/assets/audio/islamic-tour.mp3"></audio>
  </div>
</section>

<%- include('../partials/footer') %>
