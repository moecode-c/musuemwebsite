<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<% const isArabic = language === 'ar'; %>

<section class="tour-hero tour-hero--pharaoh" id="tourinfo">
  <div class="container">
    <article class="tour-hero-card">
      <p class="tour-kicker"><%= isArabic ? 'مسار 360° غامر' : '360 Immersive Route' %></p>
      <h1 class="tour-title"><%= t.virtualTour.pharaohTitle %></h1>
      <p class="tour-subtitle"><%= t.virtualTour.heroSubtitle %></p>
      <div class="tour-hero-actions">
        <a class="btn tour-hero-btn-primary" href="#tour-map"><%= isArabic ? 'ادخل الجولة الحية' : 'Enter Live Tour' %></a>
        <a class="btn tour-hero-btn-ghost" href="#tour-notes"><%= isArabic ? 'اقرأ الملاحظات' : 'Read Notes' %></a>
      </div>
    </article>
  </div>
</section>

<section class="tour-intro">
  <div class="container">
    <h2><%= t.virtualTour.pharaohTitle %></h2>
    <p><%= t.virtualTour.pharaohIntro %></p>
  </div>
</section>

<section class="tour-map" id="tour-map">
  <div class="container">
    <header class="tour-map-heading">
      <h3><%= isArabic ? 'مسار تفاعلي' : 'Interactive Route' %></h3>
      <p><%= isArabic ? 'تنقل داخل الموقع المحدد في الوقت الفعلي، ثم انتقل إلى وضع ملء الشاشة لمشاهدة أقرب إلى المتحف.' : 'Navigate the selected site in real time, then switch to fullscreen for a museum-like viewing mode.' %></p>
    </header>

    <div class="map-frame">
      <iframe
        title="<%= t.virtualTour.pharaohTitle %>"
        src="https://www.google.com/maps/embed?pb=!4v1756480706236!6m8!1m7!1sCAoSF0NJSE0wb2dLRUlDQWdJQ0V0WlhPckFF!2m2!1d37.33336496785927!2d-121.9228248894391!3f46.78690720026922!4f-27.030580023533155!5f0.7820865974627469"
        allow="fullscreen; geolocation"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
      <div class="map-ornament ornament-1"></div>
      <div class="map-ornament ornament-2"></div>
      <div class="map-ornament ornament-3"></div>
      <div class="map-ornament ornament-4"></div>
    </div>
    <div class="tour-controls">
      <button class="btn tour-btn" id="tour-fullscreen-btn" type="button"><i class="fas fa-expand"></i><%= t.virtualTour.fullscreen %></button>
      <a class="btn tour-btn" href="#tourinfo"><i class="fas fa-info-circle"></i><%= t.virtualTour.tourInfo %></a>
      <a class="btn tour-btn" href="/assets/Afterlife-museum-brochure.pdf" download="Afterlife-museum-brochure.pdf">
        <i class="fas fa-file-arrow-down"></i><%= t.virtualTour.downloadBrochure %>
      </a>
      <button class="btn tour-btn" id="tour-audio-btn" type="button" aria-label="<%= isArabic ? 'تبديل الدليل الصوتي' : 'Toggle audio guide' %>"><i class="fas fa-volume-up"></i><%= t.virtualTour.audioGuide %></button>
    </div>
  </div>
</section>

<section class="tour-info" id="tour-notes">
  <div class="container">
    <h3><%= t.virtualTour.tourNotesTitle %></h3>
    <p><%= t.virtualTour.tourNotesText %></p>
    <audio id="tour-audio" src="/assets/audio/pharoahVirtualaudio.mp3" preload="metadata"></audio>
  </div>
</section>

<%- include('../partials/footer') %>
