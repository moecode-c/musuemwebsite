<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<% const isArabic = language === 'ar'; %>

<main class="checkout-page">
  <section class="page-hero">
    <div class="container">
      <h1><%= isArabic ? 'الدفع والتوصيل' : 'Payment & Delivery' %></h1>
      <p><%= isArabic ? 'اختر طريقة الدفع واستلام الطلب.' : 'Choose how you want to pay and receive your order.' %></p>
    </div>
  </section>

  <section class="section">
    <div class="container payment-portal">
      
      <div class="payment-receipt">
        <div class="checkout-meta">
          <span class="step-pill"><%= isArabic ? 'الخطوة 2 من 2' : 'Step 2 of 2' %></span>
          <span class="muted"><%= isArabic ? 'دفع آمن' : 'Secure payment' %></span>
        </div>
        <h2><%= isArabic ? 'ملخص الطلب' : 'Order Receipt' %></h2>
        <% if (items && items.length) { %>
          <details class="receipt-details">
            <summary><%= isArabic ? 'عرض' : 'View' %> <strong><%= items.length %></strong> <%= isArabic ? 'عنصر' : 'Items' %> (<%= isArabic ? 'الإجمالي:' : 'Total:' %> EGP <%= total %>)</summary>
            <ul class="summary-list compact-receipt">
              <% items.forEach((item) => { %>
                <li>
                  <div>
                    <strong><%= item.name %></strong>
                  </div>
                  <div class="price">EGP <%= (item.price * item.quantity).toFixed(2) %></div>
                </li>
              <% }) %>
            </ul>
          </details>
          <p class="muted small-note"><%= isArabic ? 'الدفع هنا خطوة تجريبية، ولا يتم خصم أي مبالغ.' : 'Payment is a demo step. No charges are applied.' %></p>
        <% } else { %>
          <p class="muted"><%= isArabic ? 'سلة التسوق فارغة.' : 'Your cart is empty.' %></p>
        <% } %>
      </div>

      <div class="checkout-form centered-form">
        <h2><%= isArabic ? 'الدفع والتوصيل' : 'Payment & Delivery' %></h2>
        <form class="form" id="payment-delivery-form" method="post" action="/cart/payment">
          <div class="stack">
            <label><%= isArabic ? 'طريقة الدفع' : 'Payment Method' %></label>
            <div class="option-grid compact">
              <label class="option-card">
                <input type="radio" name="paymentMethod" value="card" checked />
                <div>
                  <strong><%= isArabic ? 'بطاقة' : 'Card' %></strong>
                  <p>Visa / Mastercard</p>
                </div>
              </label>
              <label class="option-card">
                <input type="radio" name="paymentMethod" value="wallet" />
                <div>
                  <strong><%= isArabic ? 'محفظة رقمية' : 'Wallet' %></strong>
                  <p>Apple Pay / Google Pay / PayPal</p>
                </div>
              </label>
              <label class="option-card">
                <input type="radio" name="paymentMethod" value="cod" />
                <div>
                  <strong><%= isArabic ? 'الدفع عند الاستلام' : 'Cash on Delivery' %></strong>
                  <p><%= isArabic ? 'ادفع عند وصول الطلب' : 'Pay when it arrives' %></p>
                </div>
              </label>
            </div>
            <div class="field-grid compact card-fields">
              <div>
                <label><%= isArabic ? 'رقم البطاقة' : 'Card Number' %></label>
                <input type="text" name="cardNumber" placeholder="1234 5678 9012 3456" />
              </div>
              <div>
                <label><%= isArabic ? 'تاريخ الانتهاء' : 'Expiry' %></label>
                <input type="text" name="expiry" placeholder="MM/YY" />
              </div>
              <div>
                <label>CVC</label>
                <input type="text" name="cvc" placeholder="123" />
              </div>
            </div>
            <p class="form-note card-fields-note"><%= isArabic ? 'حقول البطاقة اختيارية ما لم تختر الدفع بالبطاقة.' : 'Card fields are optional unless you pick card.' %></p>
          </div>

          <div class="stack">
            <label><%= isArabic ? 'خيار التوصيل' : 'Delivery Option' %></label>
            <div class="option-grid compact">
              <label class="option-card">
                <input type="radio" name="deliveryOption" value="delivery" checked />
                <div>
                  <strong><%= isArabic ? 'توصيل منزلي' : 'Home Delivery' %></strong>
                  <p><%= isArabic ? 'توصيل حتى باب المنزل' : 'Doorstep delivery' %></p>
                </div>
              </label>
              <label class="option-card">
                <input type="radio" name="deliveryOption" value="pickup" />
                <div>
                  <strong><%= isArabic ? 'استلام / خزانة' : 'Pickup / Locker' %></strong>
                  <p><%= isArabic ? 'نقطة استلام قريبة' : 'Nearby pickup point' %></p>
                </div>
              </label>
            </div>
            <div class="field-grid compact">
              <div>
                <label><%= isArabic ? 'التاريخ المفضل' : 'Preferred Date' %></label>
                <input type="date" name="deliveryDate" />
              </div>
              <div>
                <label><%= isArabic ? 'الفترة الزمنية' : 'Time Window' %></label>
                <input type="text" name="deliveryWindow" placeholder="12:00 - 15:00" />
              </div>
            </div>
            <label><%= isArabic ? 'موقع الاستلام (اختياري)' : 'Pickup Location (optional)' %></label>
            <input type="text" name="pickupSpot" placeholder="<%= isArabic ? 'الخزانة أو نقطة الاستلام' : 'Locker or pickup point' %>" />
          </div>

          <label><%= isArabic ? 'ملاحظات' : 'Notes' %></label>
          <textarea name="notes" rows="2" placeholder="<%= isArabic ? 'تعليمات التوصيل' : 'Delivery instructions' %>"></textarea>

          <button class="btn" type="submit"><%= isArabic ? 'تأكيد الدفع والتوصيل' : 'Confirm payment & delivery' %></button>
          <p class="form-message" id="payment-message"></p>
        </form>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
