<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<% const isArabic = language === 'ar'; %>

<main class="checkout-page">
  <section class="page-hero">
    <div class="container">
      <h1><%= isArabic ? 'إتمام الطلب' : 'Checkout' %></h1>
      <p><%= isArabic ? 'راجع طلبك وأدخل تفاصيل التوصيل.' : 'Review your order and enter delivery details.' %></p>
    </div>
  </section>

  <section class="section">
    <div class="container checkout-shell">
      <div class="checkout-summary">
        <h2><%= isArabic ? 'العناصر الخاصة بك' : 'Your Items' %></h2>
        <% if (items && items.length) { %>
          <ul class="summary-list">
            <% items.forEach((item) => { %>
              <li>
                <div>
                  <strong><%= item.name %></strong>
                  <p class="muted">EGP <%= item.price.toFixed(2) %> × <%= item.quantity %></p>
                </div>
                <div class="price">EGP <%= (item.price * item.quantity).toFixed(2) %></div>
              </li>
            <% }) %>
          </ul>
          <div class="summary-total"><%= isArabic ? 'الإجمالي:' : 'Total:' %> EGP <%= total %></div>
        <% } else { %>
          <p class="muted"><%= isArabic ? 'سلة التسوق فارغة.' : 'Your cart is empty.' %></p>
        <% } %>
      </div>
      <div class="checkout-form">
        <h2><%= isArabic ? 'الشحن والدفع' : 'Shipping & Payment' %></h2>
        <form class="form" id="product-checkout-form" method="post" action="/cart/checkout">
          <% if (typeof error !== 'undefined' && error) { %>
            <p class="form-message is-error" style="color:#d13f3f;"><%= isArabic ? 'يرجى إدخال الاسم وبريد إلكتروني صحيح والعنوان.' : 'Please enter your name, a valid email, and an address.' %></p>
          <% } %>
          <label><%= isArabic ? 'الاسم الكامل' : 'Full Name' %></label>
          <input type="text" name="name" value="<%= details.name || '' %>" required />
          <label><%= isArabic ? 'البريد الإلكتروني' : 'Email' %></label>
          <input type="email" name="email" value="<%= details.email || '' %>" required />
          <label><%= isArabic ? 'الهاتف' : 'Phone' %></label>
          <input type="text" name="phone" value="<%= details.phone || '' %>" required />
          <label><%= isArabic ? 'العنوان' : 'Address' %></label>
          <input type="text" name="address" value="<%= details.address || '' %>" required />
          <label><%= isArabic ? 'المدينة' : 'City' %></label>
          <input type="text" name="city" value="<%= details.city || '' %>" required />
          <label><%= isArabic ? 'ملاحظات (اختياري)' : 'Notes (optional)' %></label>
          <textarea name="notes" rows="3" placeholder="<%= isArabic ? 'أي ملاحظات للتوصيل' : 'Any delivery notes' %>"><%= details.notes || '' %></textarea>
          <button class="btn" type="submit"><%= isArabic ? 'متابعة للدفع' : 'Continue to Payment' %></button>
        </form>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
