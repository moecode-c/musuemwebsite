<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="checkout-page">
  <section class="page-hero">
    <div class="container">
      <h1>Checkout</h1>
      <p>Review your order and enter delivery details.</p>
    </div>
  </section>

  <section class="section">
    <div class="container checkout-shell">
      <div class="checkout-summary">
        <h2>Your Items</h2>
        <% if (items && items.length) { %>
          <ul class="summary-list">
            <% items.forEach((item) => { %>
              <li>
                <div>
                  <strong><%= item.name %></strong>
                  <p class="muted">EGP <%= item.price.toFixed(2) %> × <%= item.quantity %></p>
                </div>
                <div class="price">EGP <%= (item.price * item.quantity).toFixed(2) %></div>
              </li>
            <% }) %>
          </ul>
          <div class="summary-total">Total: EGP <%= total %></div>
        <% } else { %>
          <p class="muted">Your cart is empty.</p>
        <% } %>
      </div>
      <div class="checkout-form">
        <h2>Shipping & Payment</h2>
        <form class="form" id="product-checkout-form">
          <label>Full Name</label>
          <input type="text" name="name" required />
          <label>Email</label>
          <input type="email" name="email" required />
          <label>Phone</label>
          <input type="text" name="phone" required />
          <label>Address</label>
          <input type="text" name="address" required />
          <label>City</label>
          <input type="text" name="city" required />
          <label>Notes (optional)</label>
          <textarea name="notes" rows="3" placeholder="Any delivery notes"></textarea>
          <button class="btn" type="submit">Place Order</button>
          <p class="form-message" id="checkout-message"></p>
        </form>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
