<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<% const isArabic = language === 'ar'; %>

<section class="page-hero">
  <div class="container">
    <h1><%= isArabic ? 'اطلب تذكرتك' : 'Request Your Ticket' %></h1>
    <p><%= isArabic ? 'اختر التاريخ والوقت وفئة التذكرة.' : 'Choose a date, time slot, and ticket category.' %></p>
  </div>
</section>

<section class="section">
  <div class="container ticket-request">
    <div class="ticket-steps">
      <span class="step active">1</span>
      <span class="step">2</span>
      <span class="step">3</span>
      <span class="step">4</span>
    </div>
    <fieldset class="semantic-fieldset">
      <legend class="ticket-section-title semantic-legend"><%= isArabic ? 'اختر التاريخ' : 'Select Date' %></legend>
      <div class="ticket-calendar">
        <input type="date" id="ticket-date" name="date" form="ticket-request-form" autocomplete="off" required />
        <p class="ticket-hint"><%= isArabic ? 'التواريخ غير المتاحة وصلت إلى السعة القصوى.' : 'Unavailable dates have reached capacity.' %></p>
      </div>
    </fieldset>

    <fieldset class="semantic-fieldset">
      <legend class="ticket-section-title semantic-legend"><%= isArabic ? 'اختر فترة الدخول' : 'Select Entry Time Slot' %></legend>
      <div class="ticket-slots" role="group" aria-label="<%= isArabic ? 'الفترات الزمنية' : 'Time slots' %>">
        <label class="ticket-slot">
          <input type="radio" name="timeSlot" value="08:30 - 11:00" form="ticket-request-form" autocomplete="off" required />
          <span>08:30 - 11:00</span>
        </label>
        <label class="ticket-slot">
          <input type="radio" name="timeSlot" value="11:00 - 13:00" form="ticket-request-form" autocomplete="off" />
          <span>11:00 - 13:00</span>
        </label>
        <label class="ticket-slot">
          <input type="radio" name="timeSlot" value="13:00 - 15:00" form="ticket-request-form" autocomplete="off" />
          <span>13:00 - 15:00</span>
        </label>
      </div>
    </fieldset>

    <fieldset class="semantic-fieldset">
      <legend class="ticket-section-title semantic-legend"><%= isArabic ? 'اختر التذاكر' : 'Select Tickets' %></legend>
      <div class="ticket-groups">
        <% const groupLabels = isArabic
          ? { egyptian: "المصريون", arab: "العرب أو الجنسيات الأخرى", foreigner: "الأجانب المقيمون" }
          : { egyptian: "Egyptians", arab: "Arabs or Other Nationalities", foreigner: "Expatriates" }; %>
        <% const audienceLabels = isArabic
          ? { adult: "بالغ", student: "طالب", child: "طفل", senior: "كبير سن" }
          : { adult: "Adult", student: "Student", child: "Child", senior: "Senior" }; %>
        <% Object.keys(groupLabels).forEach((groupKey) => { %>
          <details class="ticket-group">
            <summary><%= groupLabels[groupKey] %></summary>
            <div class="ticket-group-body">
              <% (groupedTickets[groupKey] || []).forEach((ticket) => { %>
                <label class="ticket-option">
                  <input
                    type="radio"
                    name="ticketOption"
                    value="<%= ticket.group %>:<%= ticket.audience %>"
                    data-group="<%= ticket.group %>"
                    data-audience="<%= ticket.audience %>"
                    form="ticket-request-form"
                    required
                  />
                  <span><%= audienceLabels[ticket.audience] || ticket.audience %></span>
                  <strong>EGP <%= ticket.price.toFixed(2) %></strong>
                </label>
              <% }) %>
            </div>
          </details>
        <% }) %>
      </div>
    </fieldset>

    <form class="form ticket-form" id="ticket-request-form" autocomplete="on">
      <input type="hidden" name="category" id="ticket-category" autocomplete="off" required />
      <input type="hidden" name="audience" id="ticket-audience" autocomplete="off" required />
      <label><%= isArabic ? 'الاسم الكامل' : 'Full Name' %></label>
      <input type="text" name="name" autocomplete="name" required />
      <label><%= isArabic ? 'العمر' : 'Age' %></label>
      <input type="number" name="age" autocomplete="off" min="1" required />
      <label><%= isArabic ? 'البريد الإلكتروني' : 'Email' %></label>
      <input type="email" name="email" autocomplete="email" required />
      <label><%= isArabic ? 'الجنسية' : 'Nationality' %></label>
      <input type="text" name="nationality" autocomplete="country-name" required />
      <label><%= isArabic ? 'رقم الهاتف' : 'Phone Number' %></label>
      <input type="text" name="phone" autocomplete="tel" required />
      <label><%= isArabic ? 'عدد التذاكر' : 'Tickets Quantity' %></label>
      <input type="number" name="quantity" autocomplete="off" min="1" value="1" required />
      <button class="btn" type="submit"><%= isArabic ? 'إرسال طلب التذكرة' : 'Submit Ticket Request' %></button>
      <p class="form-message" id="ticket-request-message"></p>
    </form>
  </div>
</section>

<%- include('../partials/footer') %>
