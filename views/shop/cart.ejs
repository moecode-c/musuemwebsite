<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<section class="page-hero">
  <div class="container">
    <h1><%= t.cart.title %></h1>
    <p><%= t.cart.subtitle %></p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div id="cart-items">
      <%- cartItemsHtml %>
    </div>
    <div class="cart-total"><%= t.cart.total %>: EGP <span id="cart-total"><%= total %></span></div>
    <a class="btn" href="/checkout"><%= t.cart.checkout %></a>
  </div>
</section>

<%- include('../partials/footer') %>