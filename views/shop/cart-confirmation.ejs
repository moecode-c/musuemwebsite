<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<% const isArabic = language === 'ar'; %>

<main class="checkout-page">
  <section class="page-hero">
    <div class="container">
      <h1><%= isArabic ? 'تم تأكيد الطلب' : 'Order Confirmed' %></h1>
      <p><%= isArabic ? 'شكرا لك! تم حفظ طريقة الدفع وخطة التوصيل الخاصة بك.' : 'Thank you! Your payment preference and delivery plan have been saved.' %></p>
    </div>
  </section>

  <section class="section">
    <div class="container checkout-shell">
      <div class="checkout-summary">
        <div class="checkout-meta">
          <span class="step-pill"><%= isArabic ? 'مكتمل' : 'Completed' %></span>
          <span class="muted"><%= isArabic ? 'طلب رقم' : 'Order #' %><%= order.id %></span>
        </div>
        <h2><%= isArabic ? 'العناصر الخاصة بك' : 'Your Items' %></h2>
        <% if (order.items && order.items.length) { %>
          <ul class="summary-list">
            <% order.items.forEach((item) => { %>
              <li>
                <div>
                  <strong><%= item.name %></strong>
                  <p class="muted">EGP <%= item.price.toFixed(2) %> × <%= item.quantity %></p>
                </div>
                <div class="price">EGP <%= (item.price * item.quantity).toFixed(2) %></div>
              </li>
            <% }) %>
          </ul>
          <div class="summary-total"><%= isArabic ? 'الإجمالي المدفوع:' : 'Total paid:' %> EGP <%= order.total.toFixed(2) %></div>
        <% } else { %>
          <p class="muted"><%= isArabic ? 'لا توجد عناصر.' : 'No items found.' %></p>
        <% } %>
      </div>
      <div class="checkout-form">
        <h2><%= isArabic ? 'خطة التوصيل' : 'Delivery Plan' %></h2>
        <div class="summary-list">
          <div class="summary-list__row">
            <strong><%= isArabic ? 'طريقة الدفع' : 'Payment Method' %></strong>
            <span class="muted"><%= order.paymentMethod %></span>
          </div>
          <div class="summary-list__row">
            <strong><%= isArabic ? 'خيار التوصيل' : 'Delivery Option' %></strong>
            <span class="muted"><%= order.deliveryOption %></span>
          </div>
          <% if (order.deliveryDate || order.deliveryWindow) { %>
            <div class="summary-list__row">
              <strong><%= isArabic ? 'الفترة المفضلة' : 'Preferred Slot' %></strong>
              <span class="muted"><%= order.deliveryDate || '—' %> <%= order.deliveryWindow || '' %></span>
            </div>
          <% } %>
          <% if (order.pickupSpot) { %>
            <div class="summary-list__row">
              <strong><%= isArabic ? 'نقطة الاستلام' : 'Pickup Point' %></strong>
              <span class="muted"><%= order.pickupSpot %></span>
            </div>
          <% } %>
          <% if (order.notes) { %>
            <div class="summary-list__row">
              <strong><%= isArabic ? 'ملاحظات' : 'Notes' %></strong>
              <span class="muted"><%= order.notes %></span>
            </div>
          <% } %>
          <div class="summary-list__row">
            <strong><%= isArabic ? 'تاريخ الإنشاء' : 'Created' %></strong>
            <span class="muted"><%= order.createdAt.toLocaleString ? order.createdAt.toLocaleString() : order.createdAt %></span>
          </div>
        </div>
        <a class="btn" href="/shop"><%= isArabic ? 'متابعة التسوق' : 'Continue shopping' %></a>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
