<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<section class="page-hero">
  <div class="container">
    <h1>Map</h1>
    <p>Visit us in central Cairo and explore every gallery with interactive map pins.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="location-layout">
      <div class="location-top">
        <div>
          <div class="map-wrapper">
            <img src="/assets/map/map.png" alt="Museum map" class="map-image" />
            <div class="map-layer">
              <%- pinsHtml %>
            </div>
          </div>
          <div class="map-tooltip" id="map-tooltip"></div>
        </div>
        <aside class="common-pins">
          <h3>Most Common Pins</h3>
          <ul class="common-pin-list">
            <% if (commonPins && commonPins.length) { %>
              <% commonPins.forEach((pin) => { %>
                <li class="common-pin-item" data-x="<%= pin.x %>" data-y="<%= pin.y %>">
                  <span class="common-pin-icon" aria-hidden="true"></span>
                  <div class="common-pin-text">
                    <strong><%= pin.label %></strong>
                    <span><%= pin.description %></span>
                  </div>
                </li>
              <% }) %>
            <% } else { %>
              <li class="common-pin-empty">No common pins yet.</li>
            <% } %>
          </ul>
        </aside>
      </div>
      <div class="info-stack info-grid">
        <article class="info-card">
          <h3>Address</h3>
          <p>Al Tahrir Square, Downtown Cairo, Egypt</p>
          <p class="contact-line"><i class="fas fa-phone"></i> +20 2 2579 6584</p>
          <p class="contact-line"><i class="fas fa-envelope"></i> visit@musuem.org</p>
        </article>
        <article class="info-card">
          <h3>Hours</h3>
          <ul class="list">
            <li>Sunday–Thursday: 9:00 AM – 5:00 PM</li>
            <li>Friday: 10:00 AM – 4:00 PM</li>
            <li>Saturday: 11:00 AM – 3:00 PM</li>
          </ul>
        </article>
        <article class="info-card">
          <h3>Getting Here</h3>
          <ul class="list">
            <li>Metro: Sadat Station (5-minute walk)</li>
            <li>Bus: Routes 174, 356, 400</li>
            <li>Parking: Underground lot on Abdel Khalek Tharwat St.</li>
          </ul>
        </article>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
