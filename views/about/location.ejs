<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<section class="page-hero">
  <div class="container">
    <h1><%= t.location.title %></h1>
    <p><%= t.location.subtitle %></p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="location-layout">
      <div class="location-top">
        <div>
          <div class="map-wrapper">
            <img src="/assets/map/map.png" alt="Museum map" class="map-image" />
            <div class="map-layer">
              <%- pinsHtml %>
            </div>
          </div>
          <div class="map-tooltip" id="map-tooltip"></div>
        </div>
        <aside class="common-pins">
          <h3><%= t.location.commonPins %></h3>
          <ul class="common-pin-list">
            <% if (commonPins && commonPins.length) { %>
              <% commonPins.forEach((pin) => { %>
                <li class="common-pin-item" data-x="<%= pin.x %>" data-y="<%= pin.y %>">
                  <span class="common-pin-icon" aria-hidden="true"></span>
                  <div class="common-pin-text">
                    <strong><%= pin.label %></strong>
                    <span><%= pin.description %></span>
                  </div>
                </li>
              <% }) %>
            <% } else { %>
              <li class="common-pin-empty"><%= t.location.noPins %></li>
            <% } %>
          </ul>
        </aside>
      </div>
      <div class="info-stack info-grid">
        <article class="info-card">
          <h3><%= t.location.addressTitle %></h3>
          <p><%= t.location.addressText %></p>
          <p class="contact-line"><i class="fas fa-phone"></i> <%= t.location.phone %></p>
          <p class="contact-line"><i class="fas fa-envelope"></i> <%= t.location.email %></p>
        </article>
        <article class="info-card">
          <h3><%= t.location.hoursTitle %></h3>
          <ul class="list">
            <li><%= t.location.hours[0] %></li>
            <li><%= t.location.hours[1] %></li>
            <li><%= t.location.hours[2] %></li>
          </ul>
        </article>
        <article class="info-card">
          <h3><%= t.location.gettingHereTitle %></h3>
          <ul class="list">
            <li><%= t.location.gettingHere[0] %></li>
            <li><%= t.location.gettingHere[1] %></li>
            <li><%= t.location.gettingHere[2] %></li>
          </ul>
        </article>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>