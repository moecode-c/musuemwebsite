<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="accessibility-page">
  <section class="accessibility-hero">
    <div class="container">
      <div class="access-hero-inner">
        <div class="access-hero-label">
          <span class="access-hero-kicker"><%= language === 'ar' ? 'إمكانية الوصول' : 'ACCESSIBILITY' %></span>
          <span class="access-hero-divider">|</span>
          <span class="access-hero-kicker"><%= language === 'ar' ? 'رعاية الزوار' : 'VISITOR CARE' %></span>
        </div>
        <h1 class="access-hero-title"><%= language === 'ar' ? 'الوصول للجميع' : 'ACCESS FOR ALL' %></h1>
        <div class="access-hero-subline">
          <p><%= language === 'ar' ? 'تصميم شامل، ودعم موجّه، ورعاية محترمة في كل قاعة.' : 'INCLUSIVE DESIGN, GUIDED SUPPORT, AND RESPECTFUL CARE ACROSS EVERY GALLERY.' %></p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container access-page">
      <div class="access-intro">
        <p><%= language === 'ar' ? 'المتحف المصري ملاذ للتاريخ، ونحن نؤمن بأن التاريخ ملك للجميع. نحن ملتزمون بإزالة الحواجز الجسدية والحسية والمعرفية حتى يشعر كل زائر بالتمكين.' : 'The Egyptian Museum is a sanctuary for history, and we believe history belongs to everyone. We are dedicated to removing barriers, physical, sensory, or cognitive, so every visitor feels empowered.' %></p>
      </div>

      <section class="section access-arrival">
        <h2><%= language === 'ar' ? 'الوصول إلى المتحف' : 'Getting Here and Arrival' %></h2>
        <div class="arrival-steps">
          <div class="step-pill"><%= language === 'ar' ? 'منحدرات بلا درجات' : 'Step-free ramps' %></div>
          <div class="step-pill"><%= language === 'ar' ? 'مواقف سيارات مخصصة' : 'Accessible parking' %></div>
          <div class="step-pill"><%= language === 'ar' ? 'مصاعد عند المدخل' : 'Lifts at entrance' %></div>
          <div class="step-pill"><%= language === 'ar' ? 'أرضية لمسية' : 'Tactile paving' %></div>
        </div>
      </section>

      <section class="hub-section" aria-label="<%= language === 'ar' ? 'مركز إمكانية الوصول بالمتحف' : 'Museum accessibility hub' %>">
        <h2><%= language === 'ar' ? 'مركز إمكانية الوصول' : 'Museum Accessibility Hub' %></h2>

        <div class="hub-row hub-mobility">
          <button class="hub-toggle" type="button" aria-expanded="false">
            <span class="hub-label">
              <span class="hub-icon" aria-hidden="true"><i class="fas fa-wheelchair"></i></span>
              <span class="hub-title">
                <span class="hub-heading"><%= language === 'ar' ? 'الوصول الحركي' : 'Mobility Access' %></span>
                <span class="hub-subtitle"><%= language === 'ar' ? 'الكراسي المتحركة والمصاعد والممرات' : 'Wheelchairs, elevators, and pathways' %></span>
              </span>
            </span>
            <span class="arrow-btn" aria-hidden="true">></span>
          </button>
          <div class="hub-content" hidden>
            <ul>
              <li><%= language === 'ar' ? 'ممرات واسعة بلا درجات في جميع القاعات.' : 'Wide, step-free pathways throughout all galleries.' %></li>
              <li><%= language === 'ar' ? 'كراسي متحركة يدوية مجانية عند غرفة الملابس الرئيسية.' : 'Manual wheelchairs available free of charge at the main cloakroom.' %></li>
              <li><%= language === 'ar' ? 'مصاعد كبيرة الطاقة تخدم جميع الطوابق.' : 'Large-capacity elevators serving all floors.' %></li>
              <li><%= language === 'ar' ? 'دورات مياه مخصصة في كل طابق.' : 'Dedicated accessible restrooms on every level.' %></li>
            </ul>
          </div>
        </div>

        <div class="hub-row hub-sensory">
          <button class="hub-toggle" type="button" aria-expanded="false">
            <span class="hub-label">
              <span class="hub-icon" aria-hidden="true"><i class="fas fa-ear-listen"></i></span>
              <span class="hub-title">
                <span class="hub-heading"><%= language === 'ar' ? 'الدعم الحسي' : 'Sensory Support' %></span>
                <span class="hub-subtitle"><%= language === 'ar' ? 'الصوت والسمع والوسائل البصرية' : 'Hearing, audio, and visual aids' %></span>
              </span>
            </span>
            <span class="arrow-btn" aria-hidden="true">></span>
          </button>
          <div class="hub-content" hidden>
            <ul>
              <li><%= language === 'ar' ? 'أجهزة استماع مساعدة للجولات الإرشادية.' : 'Assistive listening devices available for guided tours.' %></li>
              <li><%= language === 'ar' ? 'شاشات مترجمة بمستويات صوت قابلة للتعديل.' : 'Captioned displays with adjustable audio levels.' %></li>
              <li><%= language === 'ar' ? 'مسارات هادئة عند الطلب.' : 'Quiet-friendly gallery routes on request.' %></li>
            </ul>
          </div>
        </div>

        <div class="hub-row hub-visual">
          <button class="hub-toggle" type="button" aria-expanded="false">
            <span class="hub-label">
              <span class="hub-icon" aria-hidden="true"><i class="fas fa-eye"></i></span>
              <span class="hub-title">
                <span class="hub-heading"><%= language === 'ar' ? 'إمكانية الوصول البصري' : 'Visual Accessibility' %></span>
                <span class="hub-subtitle"><%= language === 'ar' ? 'برايل وتباين عالٍ ولمس' : 'Braille, high-contrast, and touch' %></span>
              </span>
            </span>
            <span class="arrow-btn" aria-hidden="true">></span>
          </button>
          <div class="hub-content" hidden>
            <ul>
              <li><%= language === 'ar' ? 'خرائط لمسية متاحة عند مكتب المعلومات.' : 'Tactile maps available at the information desk.' %></li>
              <li><%= language === 'ar' ? 'كتيبات برايل وعلامات ذات تباين عالٍ.' : 'Braille guidebooks and high-contrast labels.' %></li>
              <li><%= language === 'ar' ? 'جولات لمسية قابلة للحجز قبل 48 ساعة.' : 'Touch tours bookable 48 hours in advance.' %></li>
            </ul>
          </div>
        </div>

        <div class="hub-row hub-cognitive">
          <button class="hub-toggle" type="button" aria-expanded="false">
            <span class="hub-label">
              <span class="hub-icon" aria-hidden="true"><i class="fas fa-brain"></i></span>
              <span class="hub-title">
                <span class="hub-heading"><%= language === 'ar' ? 'الراحة المعرفية والحسية' : 'Cognitive and Sensory Comfort' %></span>
                <span class="hub-subtitle"><%= language === 'ar' ? 'مساحات هادئة وأدلة سهلة' : 'Quiet spaces and easy guides' %></span>
              </span>
            </span>
            <span class="arrow-btn" aria-hidden="true">></span>
          </button>
          <div class="hub-content" hidden>
            <ul>
              <li><%= language === 'ar' ? 'خرائط حسية تبرز المناطق الهادئة.' : 'Sensory maps highlight quiet zones and low-stim areas.' %></li>
              <li><%= language === 'ar' ? 'جداول بصرية سهلة القراءة متاحة في الموقع.' : 'Easy-to-read visual schedules available on site.' %></li>
              <li><%= language === 'ar' ? 'تخطيط مسار يمكن التنبؤ به لزيارات أهدأ.' : 'Predictable route planning for calmer visits.' %></li>
            </ul>
          </div>
        </div>
      </section>

      <div class="split access-support">
        <div class="card">
          <h3><%= language === 'ar' ? 'مساعدة الموظفين' : 'Staff Assistance' %></h3>
          <p><%= language === 'ar' ? 'فريقنا مدرّب على الوعي بالإعاقة. ابحث عن الموظفين الذين يرتدون شارة إمكانية الوصول للمساعدة المتخصصة.' : 'Our team is trained in disability awareness. Look for staff wearing the Accessibility Badge for specialized help with navigation or communication.' %></p>
        </div>
        <div class="card">
          <h3><%= language === 'ar' ? 'الجولات والبرامج' : 'Tours and Programs' %></h3>
          <p><%= language === 'ar' ? 'تعلّم شامل للجميع. نستضيف صباحات مناسبة للحساسية الحسية ومحاضرات بلغة الإشارة كل أول أحد من الشهر.' : 'Inclusive learning for all. We host sensory-friendly mornings and sign-language interpreted lectures every first Sunday of the month.' %></p>
        </div>
      </div>

      <section class="stat-card access-planning">
        <h3><%= language === 'ar' ? 'التخطيط لزيارتك' : 'Planning Your Visit' %></h3>
        <p><%= language === 'ar' ? 'لضمان توفر المعدات، نوصي بحجز الكراسي المتحركة أو أجهزة الاستماع عبر الإنترنت.' : 'To ensure equipment availability, we recommend booking wheelchairs or listening devices online.' %></p>
        <button class="btn" type="button" id="book-assistance-btn" aria-expanded="false" aria-controls="assistance-panel">
          <%= language === 'ar' ? 'احجز المساعدة' : 'Book Assistance' %>
        </button>
      </section>

      <section class="assistance-panel" id="assistance-panel" hidden>
        <div class="assistance-grid">
          <form class="form assistance-form" id="assistance-form">
            <h3><%= language === 'ar' ? 'طلب المساعدة' : 'Assistance Request' %></h3>
            <label for="assist-name"><%= language === 'ar' ? 'الاسم الكامل' : 'Full name' %></label>
            <input type="text" id="assist-name" name="name" placeholder="<%= language === 'ar' ? 'اسمك' : 'Your name' %>" required />
            <label for="assist-email"><%= language === 'ar' ? 'البريد الإلكتروني' : 'Email' %></label>
            <input type="email" id="assist-email" name="email" placeholder="<%= language === 'ar' ? 'بريدك@مثال.com' : 'you@example.com' %>" required />
            <label for="assist-phone"><%= language === 'ar' ? 'الهاتف' : 'Phone' %></label>
            <input type="tel" id="assist-phone" name="phone" placeholder="+20 2 0000 0000" required />
            <label for="assist-date"><%= language === 'ar' ? 'تاريخ الزيارة' : 'Visit date' %></label>
            <input type="date" id="assist-date" name="date" required />
            <label for="assist-type"><%= language === 'ar' ? 'نوع المساعدة المطلوبة' : 'Assistance needed' %></label>
            <select id="assist-type" name="type" required>
              <option value=""><%= language === 'ar' ? 'اختر خياراً' : 'Select an option' %></option>
              <option value="wheelchair"><%= language === 'ar' ? 'دعم الكرسي المتحرك' : 'Wheelchair support' %></option>
              <option value="listening"><%= language === 'ar' ? 'أجهزة استماع مساعدة' : 'Assistive listening' %></option>
              <option value="visual"><%= language === 'ar' ? 'مساعدة بصرية' : 'Visual assistance' %></option>
              <option value="sensory"><%= language === 'ar' ? 'زيارة مناسبة حسياً' : 'Sensory-friendly visit' %></option>
              <option value="other"><%= language === 'ar' ? 'تسهيلات أخرى' : 'Other accommodations' %></option>
            </select>
            <label for="assist-notes"><%= language === 'ar' ? 'ملاحظات' : 'Notes' %></label>
            <textarea id="assist-notes" name="notes" rows="4" placeholder="<%= language === 'ar' ? 'أخبرنا كيف يمكننا المساعدة' : 'Tell us how we can help' %>"></textarea>
            <button class="btn" type="submit"><%= language === 'ar' ? 'إرسال الطلب' : 'Send Request' %></button>
          </form>

          <aside class="assistance-contact">
            <h3><%= language === 'ar' ? 'تحتاج مساعدة الآن؟' : 'Need help now?' %></h3>
            <p><%= language === 'ar' ? 'يرد مكتب إمكانية الوصول خلال يوم عمل واحد.' : 'Our accessibility desk responds within 1 business day.' %></p>
            <div class="contact-item">
              <i class="fas fa-envelope"></i>
              <span><%= t.accessibility.email %></span>
            </div>
            <div class="contact-item">
              <i class="fas fa-phone"></i>
              <span><%= t.accessibility.phone %></span>
            </div>
            <div class="contact-item">
              <i class="fas fa-location-dot"></i>
              <span><%= language === 'ar' ? 'المدخل الرئيسي، مكتب المعلومات' : 'Main entrance, info desk' %></span>
            </div>
          </aside>
        </div>
      </section>
    </div>
  </section>

  <script>
  const hubRows = document.querySelectorAll(".hub-row");
  const assistanceButton = document.getElementById("book-assistance-btn");
  const assistancePanel = document.getElementById("assistance-panel");
  hubRows.forEach((row) => {
    const toggle = row.querySelector(".hub-toggle");
    const content = row.querySelector(".hub-content");
    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      hubRows.forEach((otherRow) => {
        const otherToggle = otherRow.querySelector(".hub-toggle");
        const otherContent = otherRow.querySelector(".hub-content");
        otherToggle.setAttribute("aria-expanded", "false");
        otherRow.classList.remove("active");
        otherContent.hidden = true;
      });
      toggle.setAttribute("aria-expanded", String(!isOpen));
      row.classList.toggle("active", !isOpen);
      content.hidden = isOpen;
    });
  });
  if (assistanceButton && assistancePanel) {
    assistanceButton.addEventListener("click", () => {
      const isOpen = assistanceButton.getAttribute("aria-expanded") === "true";
      assistanceButton.setAttribute("aria-expanded", String(!isOpen));
      assistancePanel.hidden = isOpen;
      if (!isOpen) {
        assistancePanel.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    });
  }
  </script>

  <%- include('../partials/footer') %>
</main>