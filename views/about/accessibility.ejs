<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<section class="page-hero">
  <div class="container">
    <h1><%= t.accessibility.title %></h1>
    <p><%= t.accessibility.subtitle %></p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="access-grid">
      <article class="info-card">
        <i class="fas fa-wheelchair icon"></i>
        <h3><%= t.accessibility.mobilityTitle %></h3>
        <p><%= t.accessibility.mobilityText %></p>
      </article>
      <article class="info-card">
        <i class="fas fa-ear-listen icon"></i>
        <h3><%= t.accessibility.audioTitle %></h3>
        <p><%= t.accessibility.audioText %></p>
      </article>
      <article class="info-card">
        <i class="fas fa-hands-asl-interpreting icon"></i>
        <h3><%= t.accessibility.interpretationTitle %></h3>
        <p><%= t.accessibility.interpretationText %></p>
      </article>
      <article class="info-card">
        <i class="fas fa-person-shelter icon"></i>
        <h3><%= t.accessibility.sensoryTitle %></h3>
        <p><%= t.accessibility.sensoryText %></p>
      </article>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container split">
    <div>
      <h2><%= t.accessibility.supportTitle %></h2>
      <ul class="list">
        <li><%= t.accessibility.supportList[0] %></li>
        <li><%= t.accessibility.supportList[1] %></li>
        <li><%= t.accessibility.supportList[2] %></li>
        <li><%= t.accessibility.supportList[3] %></li>
      </ul>
    </div>
    <div class="info-card">
      <h3><%= t.accessibility.helpTitle %></h3>
      <p><%= t.accessibility.helpText %></p>
      <p class="contact-line"><i class="fas fa-envelope"></i> <%= t.accessibility.email %></p>
      <p class="contact-line"><i class="fas fa-phone"></i> <%= t.accessibility.phone %></p>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>