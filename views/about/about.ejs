<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<section class="page-hero">
  <div class="container">
    <h1><%= t.about.title %></h1>
    <p><%= t.about.subtitle %></p>
  </div>
</section>

<section class="section" id="mission">
  <div class="container split">
    <div>
      <h2><%= t.about.missionTitle %></h2>
      <p><%= t.about.missionText %></p>
    </div>
    <div class="info-card">
      <h2><%= t.about.deliverTitle %></h2>
      <ul>
        <li><%= t.about.deliver[0] %></li>
        <li><%= t.about.deliver[1] %></li>
        <li><%= t.about.deliver[2] %></li>
        <li><%= t.about.deliver[3] %></li>
      </ul>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <h2><%= t.about.storyTitle %></h2>

    <div class="timeline">
      <div class="timeline-item">
        <span class="timeline-year">1902</span>
        <div>
          <h3><%= t.about.story.foundationTitle %></h3>
          <p><%= t.about.story.foundationText %></p>
        </div>
      </div>

      <div class="timeline-item">
        <span class="timeline-year">1956</span>
        <div>
          <h3><%= t.about.story.expansionTitle %></h3>
          <p><%= t.about.story.expansionText %></p>
        </div>
      </div>

      <div class="timeline-item">
        <span class="timeline-year">2025</span>
        <div>
          <h3><%= t.about.story.digitalTitle %></h3>
          <p><%= t.about.story.digitalText %></p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2><%= t.about.valuesTitle %></h2>

    <div class="card-grid">
      <article class="info-card">
        <i class="fas fa-feather icon"></i>
        <h3><%= t.about.values.preservationTitle %></h3>
        <p><%= t.about.values.preservationText %></p>
      </article>

      <article class="info-card">
        <i class="fas fa-graduation-cap icon"></i>
        <h3><%= t.about.values.educationTitle %></h3>
        <p><%= t.about.values.educationText %></p>
      </article>

      <article class="info-card">
        <i class="fas fa-people-group icon"></i>
        <h3><%= t.about.values.communityTitle %></h3>
        <p><%= t.about.values.communityText %></p>
      </article>

      <article class="info-card">
        <i class="fas fa-sparkles icon"></i>
        <h3><%= t.about.values.innovationTitle %></h3>
        <p><%= t.about.values.innovationText %></p>
      </article>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container split">
    <div>
      <h2><%= t.about.visitor.title %></h2>
      <p><%= t.about.visitor.text %></p>
      <ul class="list">
        <li><%= t.about.visitor.list[0] %></li>
        <li><%= t.about.visitor.list[1] %></li>
        <li><%= t.about.visitor.list[2] %></li>
      </ul>
    </div>
    <div class="stats">
      <div class="stat">
        <span class="stat-number">3,200+</span>
        <span class="stat-label"><%= t.about.visitor.stats.artifacts %></span>
      </div>
      <div class="stat">
        <span class="stat-number">45</span>
        <span class="stat-label"><%= t.about.visitor.stats.stations %></span>
      </div>
      <div class="stat">
        <span class="stat-number">12</span>
        <span class="stat-label"><%= t.about.visitor.stats.languages %></span>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container cta">
    <h2><%= t.about.cta.title %></h2>
    <p><%= t.about.cta.text %></p>
    <a class="btn" href="/plan-trip"><%= t.about.cta.button %></a>
  </div>
</section>

<%- include('../partials/footer') %>
