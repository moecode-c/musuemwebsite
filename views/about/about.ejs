<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<%
  const storySteps = [
    { step: "01", title: t.about.story.foundationTitle, text: t.about.story.foundationText },
    { step: "02", title: t.about.story.expansionTitle, text: t.about.story.expansionText },
    { step: "03", title: t.about.story.digitalTitle, text: t.about.story.digitalText }
  ];

  const valueCards = [
    { icon: "fa-shield-halved", title: t.about.values.preservationTitle, text: t.about.values.preservationText },
    { icon: "fa-book-open-reader", title: t.about.values.educationTitle, text: t.about.values.educationText },
    { icon: "fa-people-group", title: t.about.values.communityTitle, text: t.about.values.communityText },
    { icon: "fa-wand-magic-sparkles", title: t.about.values.innovationTitle, text: t.about.values.innovationText }
  ];
%>

<main class="about-page-shell">
  <div class="about-scroll-progress" aria-hidden="true"><span></span></div>

  <section class="about-hero" aria-labelledby="about-hero-title">
    <div class="container about-hero-content">
      <p class="about-kicker about-reveal"><%= t.about.title %></p>
      <h1 class="about-title about-reveal delay-1" id="about-hero-title"><%= t.siteTitle %></h1>
      <p class="about-lead about-reveal delay-2"><%= t.about.subtitle %></p>

      <div class="about-actions about-reveal delay-3">
        <a href="/exhibits/explore-ages" class="btn about-btn-primary"><%= t.buttons.exploreExhibits %></a>
        <a href="/plan-trip" class="btn about-btn-ghost"><%= t.about.cta.button %></a>
      </div>

      <div class="about-metrics about-reveal delay-4" aria-label="Museum highlights">
        <article class="metric-chip about-interactive">
          <span class="metric-value" data-counter="100000" data-suffix="+">100,000+</span>
          <span class="metric-label"><%= t.about.visitor.stats.artifacts %></span>
        </article>
        <article class="metric-chip about-interactive">
          <span class="metric-value" data-counter="120" data-suffix="+">120+</span>
          <span class="metric-label"><%= t.about.visitor.stats.stations %></span>
        </article>
        <article class="metric-chip about-interactive">
          <span class="metric-value" data-counter="12" data-suffix="+">12+</span>
          <span class="metric-label"><%= t.about.visitor.stats.languages %></span>
        </article>
      </div>
    </div>
  </section>

  <section class="section about-vision">
    <div class="container about-vision-grid">
      <article class="about-panel about-interactive about-reveal">
        <p class="about-kicker"><%= t.about.title %></p>
        <h2 class="about-heading"><%= t.about.missionTitle %></h2>
        <p class="about-panel-text"><%= t.about.missionText %></p>

        <h3 class="about-subheading"><%= t.about.deliverTitle %></h3>
        <ul class="about-deliver-list">
          <% (t.about.deliver || []).forEach((item) => { %>
          <li>
            <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
            <span><%= item %></span>
          </li>
          <% }) %>
        </ul>
      </article>

      <figure class="about-visual about-interactive about-reveal delay-1">
        <img src="/assets/images/pillarsbg.png" alt="Grand hall of the museum" loading="lazy" />
        <figcaption>
          <h3><%= t.about.storyTitle %></h3>
          <p><%= t.about.visitor.text %></p>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section about-story">
    <div class="container">
      <p class="about-kicker about-center about-reveal"><%= t.about.storyTitle %></p>
      <div class="about-story-grid">
        <% storySteps.forEach((item, index) => { %>
        <article class="story-card about-interactive about-reveal" style="--delay:<%= index * 120 %>ms;">
          <span class="story-index"><%= item.step %></span>
          <h3><%= item.title %></h3>
          <p><%= item.text %></p>
        </article>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="section about-values">
    <div class="container">
      <p class="about-kicker about-center about-reveal"><%= t.about.valuesTitle %></p>
      <h2 class="about-heading about-center about-reveal delay-1"><%= t.about.valuesTitle %></h2>

      <div class="about-values-grid" role="list" aria-label="Museum values">
        <% valueCards.forEach((item, index) => { %>
        <article class="value-card about-interactive about-reveal" role="listitem" style="--delay:<%= index * 100 %>ms;">
          <i class="fa-solid <%= item.icon %>" aria-hidden="true"></i>
          <h3><%= item.title %></h3>
          <p><%= item.text %></p>
        </article>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="section about-visitor">
    <div class="container about-visitor-grid">
      <article class="visitor-copy about-reveal">
        <p class="about-kicker"><%= t.about.visitor.title %></p>
        <h2 class="about-heading"><%= t.about.visitor.title %></h2>
        <p class="about-panel-text"><%= t.about.visitor.text %></p>

        <ul class="visitor-list">
          <% (t.about.visitor.list || []).forEach((item) => { %>
          <li>
            <i class="fa-solid fa-angle-right" aria-hidden="true"></i>
            <span><%= item %></span>
          </li>
          <% }) %>
        </ul>
      </article>

      <figure class="visitor-media about-interactive about-reveal delay-1">
        <img src="/assets/images/pyramidsbg.png" alt="Historic pyramids at sunset" loading="lazy" />
        <figcaption class="visitor-media-badge">
          <span><%= t.about.deliverTitle %></span>
          <strong><%= (t.about.deliver || []).length %>+</strong>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section about-cta">
    <div class="container">
      <div class="about-cta-panel about-reveal">
        <h2><%= t.about.cta.title %></h2>
        <p><%= t.about.cta.text %></p>
        <div class="about-actions">
          <a href="/plan-trip" class="btn about-btn-primary"><%= t.about.cta.button %></a>
          <a href="/exhibits" class="btn about-btn-ghost"><%= t.buttons.learnMore %></a>
        </div>
      </div>
    </div>
  </section>
</main>

<script src="/javascript/about.js"></script>
<%- include('../partials/footer') %>
