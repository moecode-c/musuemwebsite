<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<section class="page-hero">
  <div class="container">
    <h1>About the Museum</h1>
    <p>Honoring Egypt's heritage through immersive storytelling, research, and innovation.</p>
  </div>
</section>

<section class="section" id="mission">
  <div class="container split">
    <div>
      <h2>Mission and Goal</h2>
      <p>
        Our mission is to preserve, interpret, and share Egypt's cultural legacy. We aim to inspire
        curiosity, deepen historical understanding, and connect visitors with the people, beliefs,
        and achievements that shaped civilization.
      </p>
    </div>
    <div class="info-card">
      <h3>What We Deliver</h3>
      <ul class="list">
        <li>Scholarly exhibitions grounded in ongoing research.</li>
        <li>Interactive learning for families, schools, and travelers.</li>
        <li>Inclusive access through multilingual and sensory resources.</li>
        <li>Digital preservation for future generations.</li>
      </ul>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <h2>Our Story</h2>
    <div class="timeline">
      <div class="timeline-item">
        <span class="timeline-year">1902</span>
        <div>
          <h3>Foundation</h3>
          <p>Established to safeguard Egypt's archaeological heritage and public education.</p>
        </div>
      </div>
      <div class="timeline-item">
        <span class="timeline-year">1956</span>
        <div>
          <h3>National Expansion</h3>
          <p>Expanded galleries to include daily life, faith, and artistic traditions.</p>
        </div>
      </div>
      <div class="timeline-item">
        <span class="timeline-year">2025</span>
        <div>
          <h3>Digital Renaissance</h3>
          <p>Launched virtual tours, multilingual audio guides, and open research access.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2>Values That Guide Us</h2>
    <div class="card-grid">
      <article class="info-card">
        <i class="fas fa-feather icon"></i>
        <h3>Preservation</h3>
        <p>Protecting artifacts with conservation science and ethical stewardship.</p>
      </article>
      <article class="info-card">
        <i class="fas fa-graduation-cap icon"></i>
        <h3>Education</h3>
        <p>Inviting learners of all ages to engage with history through stories and design.</p>
      </article>
      <article class="info-card">
        <i class="fas fa-people-group icon"></i>
        <h3>Community</h3>
        <p>Partnering with local artisans, researchers, and cultural institutions.</p>
      </article>
      <article class="info-card">
        <i class="fas fa-sparkles icon"></i>
        <h3>Innovation</h3>
        <p>Blending heritage with modern technology to unlock deeper understanding.</p>
      </article>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container split">
    <div>
      <h2>Visitor Experience</h2>
      <p>
        From guided tours to quiet reflection spaces, we design every gallery to be inspiring,
        accessible, and welcoming.
      </p>
      <ul class="list">
        <li>Daily curator talks and rotating spotlight artifacts.</li>
        <li>Hands-on learning labs for students and educators.</li>
        <li>Climate-controlled vaults for rare manuscripts.</li>
      </ul>
    </div>
    <div class="stats">
      <div class="stat">
        <span class="stat-number">3,200+</span>
        <span class="stat-label">Artifacts on display</span>
      </div>
      <div class="stat">
        <span class="stat-number">45</span>
        <span class="stat-label">Interactive stations</span>
      </div>
      <div class="stat">
        <span class="stat-number">12</span>
        <span class="stat-label">Languages supported</span>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container cta">
    <h2>Plan your visit</h2>
    <p>Explore exhibitions, reserve tickets, and create your personalized itinerary.</p>
    <a class="btn" href="/plan-trip">Start Planning</a>
  </div>
</section>

<%- include('../partials/footer') %>
