<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<section class="page-hero">
  <div class="container">
    <h1><%= t.newsletter.title %></h1>
    <p><%= t.newsletter.subtitle %></p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="split">
      <div>
        <h2><%= t.newsletter.receiveTitle %></h2>
        <ul class="list">
          <li><%= t.newsletter.receiveList[0] %></li>
          <li><%= t.newsletter.receiveList[1] %></li>
          <li><%= t.newsletter.receiveList[2] %></li>
          <li><%= t.newsletter.receiveList[3] %></li>
        </ul>
        <div class="info-card newsletter-note">
          <h3><%= t.newsletter.frequencyTitle %></h3>
          <p><%= t.newsletter.frequencyText %></p>
        </div>
      </div>
      <form class="form" id="newsletter-form">
        <label><%= t.newsletter.fullName %></label>
        <input type="text" name="name" placeholder="<%= t.newsletter.namePlaceholder %>" />
        <label><%= t.newsletter.email %></label>
        <input type="email" name="email" placeholder="<%= t.newsletter.emailPlaceholder %>" required />
        <label><%= t.newsletter.interests %></label>
        <select name="interest">
          <option value="all"><%= t.newsletter.allUpdates %></option>
          <option value="exhibitions"><%= t.newsletter.exhibitions %></option>
          <option value="events"><%= t.newsletter.events %></option>
          <option value="research"><%= t.newsletter.research %></option>
        </select>
        <button class="btn" type="submit"><%= t.newsletter.subscribe %></button>
        <p class="form-message" id="newsletter-message"></p>
      </form>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>