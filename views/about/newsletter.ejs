<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<section class="page-hero">
  <div class="container">
    <h1>Newsletter</h1>
    <p>Get exhibition previews, curator stories, and event invitations straight to your inbox.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="split">
      <div>
        <h2>What you'll receive</h2>
        <ul class="list">
          <li>Monthly highlights from the Pharaohs, Islamic, and Christian galleries.</li>
          <li>Behind-the-scenes conservation updates and artifact spotlights.</li>
          <li>Early access to workshops, tours, and special programs.</li>
          <li>Members-only discounts in the museum shop.</li>
        </ul>
        <div class="info-card newsletter-note">
          <h3>Frequency</h3>
          <p>We send 1-2 emails per month. No spam. Unsubscribe anytime.</p>
        </div>
      </div>
      <form class="form" id="newsletter-form">
        <label>Full Name (optional)</label>
        <input type="text" name="name" placeholder="Your name" />
        <label>Email</label>
        <input type="email" name="email" placeholder="you@example.com" required />
        <label>Interests</label>
        <select name="interest">
          <option value="all">All updates</option>
          <option value="exhibitions">Exhibitions</option>
          <option value="events">Events & Workshops</option>
          <option value="research">Research & Conservation</option>
        </select>
        <button class="btn" type="submit">Subscribe</button>
        <p class="form-message" id="newsletter-message"></p>
      </form>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
