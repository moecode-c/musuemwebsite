<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="newsletter-page">
  <section class="newsletter-hero">
    <div class="container">
      <div class="hero-content-inner">
        <div class="hero-label">
          <span class="roman-numeral">MONTHLY EDITION</span>
          <span class="divider">|</span>
          <span class="issue-no">NEWSLETTER</span>
        </div>

        <h1 class="font-cinzel-deco">MUSEUM INSIDER</h1>

        <div class="hero-subline">
          <p>CURATED UPDATES FROM EXHIBITIONS, EVENTS, AND DISCOVERIES</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="subscribe-wrapper">
        <div class="newsletter-card">
          <div class="card-header">
            <i class="nav-icon fas fa-paper-plane"></i>
            <span class="nav-title">Newsletter</span>
          </div>

          <h2 class="card-title">Stay updated on the future of intellectual property.</h2>

          <form action="/newsletter/subscribe" method="POST" class="subscribe-form" id="newsletter-form">
            <div class="subscribe-fields">
              <input
                type="text"
                name="name"
                placeholder="Full name"
                required
                class="subscribe-input"
              />
              <input
                type="tel"
                name="phone"
                placeholder="Phone number"
                required
                class="subscribe-input"
              />
            </div>
            <div class="email-group">
              <input
                type="email"
                name="email"
                placeholder="name@email.com"
                required
                class="email-input"
              />
            </div>
            <button type="submit" class="btn-subscribe">
              Subscribe
            </button>
          </form>

          <p class="form-message" id="newsletter-message"></p>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
