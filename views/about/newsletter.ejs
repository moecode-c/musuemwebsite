<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="newsletter-page">
  <section class="newsletter-hero">
    <div class="container">
      <div class="hero-content-inner">
        <div class="hero-label">
          <span class="roman-numeral"><%= t.newsletter.monthlyEdition %></span>
          <span class="divider">|</span>
          <span class="issue-no"><%= t.newsletter.title %></span>
        </div>
        <h1 class="font-cinzel-deco"><%= t.newsletter.insiderTitle %></h1>
        <div class="hero-subline">
          <p><%= t.newsletter.subtitle %></p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="subscribe-wrapper">
        <div class="newsletter-card">
          <div class="card-header">
            <i class="nav-icon fas fa-paper-plane"></i>
            <span class="nav-title"><%= t.newsletter.title %></span>
          </div>
          <h2 class="card-title"><%= t.newsletter.subtitle %></h2>
          <form action="/newsletter/subscribe" method="POST" class="subscribe-form" id="newsletter-form">
            <div class="subscribe-fields">
              <input type="text" name="name" placeholder="<%= t.newsletter.namePlaceholder %>" required class="subscribe-input" />
              <input type="tel" name="phone" placeholder="<%= t.newsletter.phone %>" required class="subscribe-input" />
            </div>
            <div class="email-group">
              <input type="email" name="email" placeholder="<%= t.newsletter.emailPlaceholder %>" required class="email-input" />
            </div>
            <button type="submit" class="btn-subscribe"><%= t.newsletter.subscribe %></button>
          </form>
          <p class="form-message" id="newsletter-message"></p>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>