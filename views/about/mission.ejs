<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="mission-page">
	<section class="mission-hero">
		<div class="container mission-hero-content">
			<p class="mission-kicker">Established 1835</p>
			<h1 class="mission-title">Mission and Goals</h1>
			<p class="mission-lead">
				To protect, preserve, and present the immortal spirit of Egyptian heritage for the enlightenment of the world.
			</p>
			<p class="mission-subtitle">
				The Egyptian Museum stands as the global custodian of the longest continuous civilization in human history.
			</p>
		</div>
	</section>

	<div class="hieroglyph-divider">
		<div class="line"></div>
		<div class="symbols">𓂀 𓁷 𓋹 𓊽 𓉐</div>
		<div class="line line-right"></div>
	</div>

	<section class="stats-section bg-pattern">
		<div class="container">
			<div class="stats-grid">
				<%
					const stats = [
						{ target: 120000, label: 'Artifacts Preserved', h: '𓊽', suffix: '+', format: 'number' },
						{ target: 5000, label: 'Years of History', h: '𓇳', suffix: '+', format: 'number' },
						{ target: 2000000, label: 'Visitors Annually', h: '𓁷', suffix: '+', format: 'short' },
						{ target: 50, label: 'Research Partners', h: '𓏛', suffix: '+', format: 'number' }
					];
				%>
				<% stats.forEach((s, i) => { %>
					<div class="stat-item animate-fade-up delay-<%= i + 1 %>">
						<span class="stat-hieroglyph"><%= s.h %></span>
						<div
							class="stat-value text-gradient-gold"
							data-target="<%= s.target %>"
							data-suffix="<%= s.suffix %>"
							data-format="<%= s.format %>"
						>
							0
						</div>
						<p class="stat-label"><%= s.label %></p>
					</div>
				<% }); %>
			</div>
		</div>
	</section>

	<div class="hieroglyph-divider">
		<div class="line"></div>
		<div class="symbols">𓂀 𓁷 𓋹 𓊽 𓉐</div>
		<div class="line line-right"></div>
	</div>

	<section class="pillars-section">
		<div class="top-border"></div>
		<div class="container">
			<div class="section-header animate-fade-up">
				<span class="hieroglyphs">𓊹𓊹𓊹</span>
				<p class="eyebrow">Pillars of Purpose</p>
				<h2 class="text-gradient-gold">Our Goals</h2>
				<p class="subtitle">Five foundational principles guide every decision, exhibition, and interaction at the museum.</p>
			</div>
			<div class="pillars-grid" id="pillarsGrid">
				<%
					const pillars = [
						{
							title: 'Preservation',
							hieroglyph: '𓂀',
							summary: 'Protecting artifacts for future generations through ethical conservation.',
							icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
							details: [
								'State-of-the-art conservation laboratories',
								'Climate-controlled artifact storage',
								'Ethical restoration practices guided by international standards'
							]
						},
						{
							title: 'Education',
							hieroglyph: '𓏛',
							summary: 'Supporting learning for all ages through exhibitions and programs.',
							icon: '<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>',
							details: [
								'Interactive exhibitions and guided tours',
								'School and university partnership programs',
								'Digital archives and virtual learning resources'
							]
						},
						{
							title: 'Accessibility',
							hieroglyph: '𓁷',
							summary: 'Welcoming all visitors with equal access regardless of ability.',
							icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
							details: [
								'Wheelchair-accessible galleries and pathways',
								'Multi-language audio guides and signage',
								'Sensory-friendly visiting hours and tactile exhibits'
							]
						},
						{
							title: 'Research',
							hieroglyph: '𓃀',
							summary: 'Advancing knowledge through archaeological and historical research.',
							icon: '<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>',
							details: [
								'Collaboration with international research institutions',
								'Publication of scholarly journals and findings',
								'Support for emerging Egyptologists and archaeologists'
							]
						},
						{
							title: 'Cultural Identity',
							hieroglyph: '𓉐',
							summary: 'Promoting Egyptian heritage and connecting history to the world.',
							icon: '<line x1="12" y1="2" x2="12" y2="22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>',
							details: [
								'Traveling exhibitions showcasing Egyptian civilization',
								'Cultural exchange programs with global museums',
								'Community events celebrating Egyptian traditions'
							]
						}
					];
				%>
				<% pillars.forEach((p, i) => { %>
					<div class="pillar-card animate-fade-up delay-<%= Math.min(i + 1, 5) %>" data-index="<%= i %>">
						<div class="pillar-top-bar"></div>
						<div class="pillar-body">
							<span class="pillar-hieroglyph"><%= p.hieroglyph %></span>
							<div class="pillar-icon">
								<svg viewBox="0 0 24 24"><%- p.icon %></svg>
							</div>
							<h3><%= p.title %></h3>
							<p class="summary"><%= p.summary %></p>
							<div class="pillar-details">
								<div class="pillar-details-inner">
									<p class="label">How we do this</p>
									<ul>
										<% p.details.forEach((detail) => { %>
											<li><span class="diamond">◆</span> <%= detail %></li>
										<% }); %>
									</ul>
								</div>
							</div>
						</div>
						<div class="pillar-bottom-bar"></div>
					</div>
				<% }); %>
			</div>
		</div>
		<div class="bottom-border"></div>
	</section>

	<section class="timeline-section">
		<div class="container">
			<div class="section-header animate-fade-up">
				<span class="hieroglyphs">𓂧𓇳𓂧</span>
				<p class="eyebrow">Through Time</p>
				<h2 class="text-gradient-gold">Past · Present · Future</h2>
			</div>
			<div class="timeline-wrapper">
				<div class="timeline-line">
					<div class="timeline-line-inner"></div>
				</div>
				<div class="timeline-items">
					<%
						const timeline = [
							{
								era: 'Preserve the Past',
								hieroglyph: '𓊽',
								icon: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
								description: 'We safeguard over 120,000 artifacts spanning 5,000 years of Egyptian civilization. Through meticulous conservation and ethical stewardship, we ensure these treasures endure for millennia to come.'
							},
							{
								era: 'Educate the Present',
								hieroglyph: '𓇳',
								icon: '<circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>',
								description: 'Our exhibitions, workshops, and digital resources bring ancient Egypt to life. We serve students, researchers, families, and tourists — fostering curiosity and understanding across all ages and abilities.'
							},
							{
								era: 'Inspire the Future',
								hieroglyph: '𓋹',
								icon: '<path d="M12 2L15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2z"/>',
								description: 'By connecting Egypt\'s timeless legacy to the global community, we inspire new generations of scholars, artists, and cultural leaders. The museum is a bridge between civilizations — past, present, and future.'
							}
						];
					%>
					<% timeline.forEach((t, i) => { %>
						<div class="timeline-item animate-fade-up delay-<%= i + 2 %>">
							<div class="timeline-dot"></div>
							<div class="timeline-card">
								<div class="corner-tl"></div>
								<div class="corner-br"></div>
								<div class="timeline-card-header">
									<span class="t-hieroglyph"><%= t.hieroglyph %></span>
									<div class="t-icon">
										<svg viewBox="0 0 24 24"><%- t.icon %></svg>
									</div>
								</div>
								<h3 class="text-gradient-gold"><%= t.era %></h3>
								<p><%= t.description %></p>
							</div>
						</div>
					<% }); %>
				</div>
			</div>
		</div>
	</section>

	<section class="cta-section">
		<div class="top-border"></div>
		<div class="cta-glow"><div></div></div>
		<div class="cta-content animate-fade-up">
			<span class="cta-ankh">𓋹</span>
			<blockquote>"Our mission guides every exhibition, every artifact, and every visitor experience."</blockquote>
			<div class="hieroglyph-divider cta-divider">
				<div class="line"></div>
				<div class="symbols">𓂀 𓁷 𓋹</div>
				<div class="line line-right"></div>
			</div>
			<p class="cta-sub">Step inside and discover five thousand years of wonder, knowledge, and cultural pride.</p>
			<div class="cta-buttons">
				<a href="/exhibits" class="btn-primary">Explore the Collection</a>
				<a href="/plan-trip" class="btn-outline">Plan Your Visit</a>
			</div>
		</div>
	</section>
</main>

<script src="/javascript/mission.js"></script>
<%- include('../partials/footer') %>
