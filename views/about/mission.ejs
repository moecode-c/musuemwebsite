<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="mission-page">
  <section class="mission-hero">
    <div class="container mission-hero-content">
      <p class="mission-kicker"><%= t.mission.kicker %></p>
      <h1 class="mission-title"><%= t.mission.title %></h1>
      <p class="mission-lead"><%= t.mission.lead %></p>
      <p class="mission-subtitle"><%= t.mission.subtitle %></p>
    </div>
  </section>

  <div class="hieroglyph-divider">
    <div class="line"></div>
    <div class="symbols">𓂀 𓁷 𓋹 𓊽 𓉐</div>
    <div class="line line-right"></div>
  </div>

  <section class="stats-section bg-pattern">
    <div class="container">
      <div class="stats-grid">
        <%
          const statData = [
            { target: 120000, h: '𓊽', suffix: '+', format: 'number' },
            { target: 5000, h: '𓇳', suffix: '+', format: 'number' },
            { target: 2000000, h: '𓁷', suffix: '+', format: 'short' },
            { target: 50, h: '𓏛', suffix: '+', format: 'number' }
          ];
        %>
        <% statData.forEach((s, i) => { %>
          <div class="stat-item animate-fade-up delay-<%= i + 1 %>">
            <span class="stat-hieroglyph"><%= s.h %></span>
            <div class="stat-value text-gradient-gold" data-target="<%= s.target %>" data-suffix="<%= s.suffix %>" data-format="<%= s.format %>">0</div>
            <p class="stat-label"><%= t.mission.stats[i].label %></p>
          </div>
        <% }); %>
      </div>
    </div>
  </section>

  <div class="hieroglyph-divider">
    <div class="line"></div>
    <div class="symbols">𓂀 𓁷 𓋹 𓊽 𓉐</div>
    <div class="line line-right"></div>
  </div>

  <section class="pillars-section">
    <div class="top-border"></div>
    <div class="container">
      <div class="section-header animate-fade-up">
        <span class="hieroglyphs">𓊹𓊹𓊹</span>
        <p class="eyebrow"><%= t.mission.pillarsEyebrow %></p>
        <h2 class="text-gradient-gold"><%= t.mission.pillarsTitle %></h2>
        <p class="subtitle"><%= t.mission.pillarsSubtitle %></p>
      </div>
      <div class="pillars-grid" id="pillarsGrid">
        <%
          const pillarIcons = [
            '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
            '<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>',
            '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
            '<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>',
            '<line x1="12" y1="2" x2="12" y2="22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>'
          ];
          const pillarHieroglyphs = ['𓂀', '𓏛', '𓁷', '𓃀', '𓉐'];
        %>
        <% t.mission.pillars.forEach((p, i) => { %>
          <div class="pillar-card animate-fade-up delay-<%= Math.min(i + 1, 5) %>" data-index="<%= i %>">
            <div class="pillar-top-bar"></div>
            <div class="pillar-body">
              <span class="pillar-hieroglyph"><%= pillarHieroglyphs[i] %></span>
              <div class="pillar-icon">
                <svg viewBox="0 0 24 24"><%- pillarIcons[i] %></svg>
              </div>
              <h3><%= p.title %></h3>
              <p class="summary"><%= p.summary %></p>
              <div class="pillar-details">
                <div class="pillar-details-inner">
                  <p class="label"><%= p.detailsLabel %></p>
                  <ul>
                    <% p.details.forEach((detail) => { %>
                      <li><span class="diamond">◆</span> <%= detail %></li>
                    <% }); %>
                  </ul>
                </div>
              </div>
            </div>
            <div class="pillar-bottom-bar"></div>
          </div>
        <% }); %>
      </div>
    </div>
    <div class="bottom-border"></div>
  </section>

  <section class="timeline-section">
    <div class="container">
      <div class="section-header animate-fade-up">
        <span class="hieroglyphs">𓂧𓇳𓂧</span>
        <p class="eyebrow"><%= t.mission.timelineEyebrow %></p>
        <h2 class="text-gradient-gold"><%= t.mission.timelineTitle %></h2>
      </div>
      <div class="timeline-wrapper">
        <div class="timeline-line">
          <div class="timeline-line-inner"></div>
        </div>
        <div class="timeline-items">
          <%
            const timelineIcons = [
              '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
              '<circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>',
              '<path d="M12 2L15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2z"/>'
            ];
            const timelineHieroglyphs = ['𓊽', '𓇳', '𓋹'];
          %>
          <% t.mission.timeline.forEach((item, i) => { %>
            <div class="timeline-item animate-fade-up delay-<%= i + 2 %>">
              <div class="timeline-dot"></div>
              <div class="timeline-card">
                <div class="corner-tl"></div>
                <div class="corner-br"></div>
                <div class="timeline-card-header">
                  <span class="t-hieroglyph"><%= timelineHieroglyphs[i] %></span>
                  <div class="t-icon">
                    <svg viewBox="0 0 24 24"><%- timelineIcons[i] %></svg>
                  </div>
                </div>
                <h3 class="text-gradient-gold"><%= item.era %></h3>
                <p><%= item.description %></p>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    </div>
  </section>

</main>

<script src="/javascript/mission.js"></script>
<%- include('../partials/footer') %>