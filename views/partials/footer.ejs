<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-column">
        <h3><%= t.siteTitle %></h3>
        <p><%= t.footer.description %></p>
        <div class="footer-social" aria-label="Social links">
          <a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
          <a href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
          <a href="#" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
          <a href="#" aria-label="X"><i class="fab fa-x-twitter"></i></a>
        </div>
      </div>

      <div class="footer-column">
        <h4><%= t.footer.visit %></h4>
        <ul class="footer-links">
          <li><a href="/location"><%= t.footer.location %></a></li>
          <li><a href="/plan-trip"><%= t.footer.hours %></a></li>
          <li><a href="/plan-trip"><%= t.footer.guidedTours %></a></li>
        </ul>
      </div>

      <div class="footer-column">
        <h4><%= t.footer.explore %></h4>
        <ul class="footer-links">
          <li><a href="/exhibits"><%= t.footer.featuredExhibits %></a></li>
          <li><a href="/virtual-tour"><%= t.footer.virtualTours %></a></li>
          <li><a href="/shop"><%= t.footer.museumShop %></a></li>
          <li><a href="/games"><%= language === "ar" ? "الألعاب" : "Games" %></a></li>
          <li><a href="/contact"><%= language === "ar" ? "تواصل معنا" : "Contact" %></a></li>
        </ul>
      </div>

      <div class="footer-column">
        <h4><%= t.footer.connect %></h4>
        <ul class="footer-links">
          <li><a href="mailto:info@egyptianmuseum.edu"><%= t.footer.email %>: <span dir="ltr">info@egyptianmuseum.edu</span></a></li>
          <li><a href="tel:+20225796584"><%= t.footer.phone %>: <span dir="ltr">+20 2 2579 6584</span></a></li>
          <li><a href="mailto:help@egyptianmuseum.edu"><%= t.footer.support %>: <span dir="ltr">help@egyptianmuseum.edu</span></a></li>
          <li><a href="/newsletter"><%= t.footer.newsletter %></a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span><%= t.footer.copyright %></span>
      <div class="footer-bottom-links">
        <a href="/about"><%= t.footer.about %></a>
        <a href="/accessibility"><%= t.footer.accessibility %></a>
        <a href="/newsletter"><%= t.footer.newsletter %></a>
        <a href="/faqs"><%= language === "ar" ? "الأسئلة الشائعة" : "FAQs" %></a>
      </div>
    </div>
  </div>
</footer>
<script src="/javascript/main.js"></script>
<script src="/javascript/validation.js"></script>
<script src="/javascript/cart.js"></script>
<script src="/javascript/newsletter.js"></script>
<script src="/javascript/testimonials.js"></script>
<script src="/javascript/admin.js"></script>
<script src="/javascript/map.js"></script>
<script src="/javascript/localization.js"></script>
<script src="/javascript/quiz.js"></script>
<script src="/javascript/auth.js"></script>
<script src="/javascript/virtual-tour.js"></script>
<script src="/javascript/theme.js"></script>
<script src="/javascript/ticket-requests.js"></script>
<script src="/javascript/employee-map.js"></script>
  </body>
</html>
