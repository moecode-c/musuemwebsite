<%- include('./header') %>
<div class="admin-layout">
  <aside class="admin-sidebar">
    <div class="admin-brand">
      <span class="admin-brand-title"><%= t.siteTitle %></span>
      <span class="admin-brand-subtitle"><%= panelLabel || 'Employee Panel' %></span>
    </div>
    <nav class="admin-nav">
      <a class="admin-nav-link <%= employeeNavKey === 'dashboard' ? 'is-active' : '' %>" href="/employee/dashboard"><i class="fas fa-gauge"></i>Dashboard</a>
      <% if (dashboardRole === 'museum_manager') { %>
      <a class="admin-nav-link <%= employeeNavKey === 'tasks' ? 'is-active' : '' %>" href="/employee/manager/tasks"><i class="fas fa-list-check"></i>Task Management</a>
      <a class="admin-nav-link <%= employeeNavKey === 'zones' ? 'is-active' : '' %>" href="/employee/manager/zones"><i class="fas fa-map"></i>Zone Management</a>
      <% } %>
    </nav>
    <div class="admin-nav-footer">
      <form class="inline-form" action="/auth/logout" method="post">
        <button class="admin-nav-link dropdown-button" type="submit"><i class="fas fa-right-from-bracket"></i>Logout</button>
      </form>
      <a class="admin-nav-link" href="/"><i class="fas fa-arrow-left"></i>Back to site</a>
    </div>
  </aside>
  <main class="admin-content">
    <div class="admin-content-inner">