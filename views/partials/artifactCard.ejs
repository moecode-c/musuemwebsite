<article class="artifact-card">
  <% const museumLabel = card.museumLabel || "Egyptian Museum"; %>
  <% const detailsHref = card.ctaHref || (card._id ? `/exhibits/${card._id}` : "/exhibits"); %>
  <img class="artifact-image" src="<%= card.imageUrl %>" alt="<%= card.title %>" loading="lazy" onerror="this.onerror=null;this.src='/assets/images/pillarsbg.png';" />
  <div class="artifact-body">
    <h3><%= card.title %></h3>
    <p class="artifact-museum"><%= museumLabel %></p>
    <p class="artifact-description"><%= card.description && card.description.length > 150 ? `${card.description.substring(0, 150)}...` : (card.description || "") %></p>
    <div class="artifact-facts">
      <% if (card.era) { %><p><%= card.era %></p><% } %>
      <% if (card.period) { %><p><%= card.period %></p><% } %>
      <% if (card.location) { %><p><%= card.location %></p><% } %>
    </div>
    <a class="btn artifact-btn" href="<%= detailsHref %>"><%= card.ctaLabel || "View 3D Model Artifact" %></a>
  </div>
</article>
