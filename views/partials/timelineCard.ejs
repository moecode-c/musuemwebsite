<article class="timeline-item <%= index % 2 === 0 ? 'left' : 'right' %>">
  <span class="timeline-node" aria-hidden="true"></span>
  <div class="timeline-card">
    <div class="timeline-card-media">
      <img src="<%= timeline.imageUrl %>" alt="<%= timeline.title %>" loading="lazy" />
    </div>
    <div class="timeline-card-body">
      <span class="timeline-era"><%= timeline.era || (language === 'ar' ? 'حقبة تاريخية' : 'Historical Era') %></span>
      <h3><%= timeline.title %></h3>
      <% if (timeline.period || timeline.location) { %>
      <div class="timeline-meta">
        <% if (timeline.period) { %><span><strong><%= t.exhibitDetail.period %>:</strong> <%= timeline.period %></span><% } %>
        <% if (timeline.location) { %><span><strong><%= t.exhibitDetail.origin %>:</strong> <%= timeline.location %></span><% } %>
      </div>
      <% } %>
      <p><%= timeline.description && timeline.description.length > 120 ? `${timeline.description.substring(0, 120)}...` : (timeline.description || "") %></p>
    </div>
  </div>
</article>