<header class="site-header">
  <div class="nav-primary">
    <div class="nav-top">
      <div class="container nav-top-inner">
        <div class="nav-title"><%= t.siteTitle %></div>
        <div class="nav-top-actions">
          <button class="nav-toggle" id="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links" aria-label="<%= t.nav.menu %>">
            <i class="nav-icon fas fa-bars"></i>
            <span class="nav-toggle-text"><%= t.nav.menu %></span>
          </button>
          <div class="nav-top-links">
            <%- authSectionHtml %>
            <div class="lang-switch">
              <a href="/lang/en?returnTo=<%= encodeURIComponent(currentPathWithQuery || '/') %>" class="nav-link">EN</a>
              <span>|</span>
              <a href="/lang/ar?returnTo=<%= encodeURIComponent(currentPathWithQuery || '/') %>" class="nav-link">AR</a>
            </div>
            <button class="nav-link theme-toggle" id="theme-toggle" type="button" data-theme-label="<%= t.nav.theme %>"><i class="nav-icon fas fa-moon"></i><%= t.nav.theme %></button>
            <a href="/cart" class="nav-link cart-chip" aria-label="<%= t.nav.shopMenu.cart %>">
              <i class="nav-icon fas fa-cart-shopping"></i>
              <%= t.nav.shopMenu.cart %>
              <span class="cart-count" id="cart-count">0</span>
            </a>
          </div>
        </div>
      </div>
    </div>
    <div class="nav-bottom">
      <div class="container nav-bottom-inner">
        <nav class="nav-links" id="nav-links">
          <a href="/" class="nav-link"><i class="nav-icon fas fa-home"></i><%= t.nav.home %></a>

        <div class="nav-item">
          <button class="nav-link nav-trigger" type="button"><i class="nav-icon fas fa-info-circle"></i><%= t.nav.about %></button>
          <div class="dropdown">
            <a href="/about" class="dropdown-link"><i class="dropdown-icon fas fa-circle-info"></i><%= t.nav.aboutMenu.aboutUs %></a>
            <a href="/mission" class="dropdown-link"><i class="dropdown-icon fas fa-bullseye"></i><%= t.nav.aboutMenu.mission %></a>
            <a href="/accessibility" class="dropdown-link"><i class="dropdown-icon fas fa-universal-access"></i><%= t.nav.aboutMenu.accessibility %></a>
            <a href="/newsletter" class="dropdown-link"><i class="dropdown-icon fas fa-newspaper"></i><%= t.nav.aboutMenu.newsletter %></a>
            <a href="/location" class="dropdown-link"><i class="dropdown-icon fas fa-map-marker-alt"></i><%= t.nav.aboutMenu.map %></a>
            <a href="/testimonials" class="dropdown-link"><i class="dropdown-icon fas fa-comments"></i><%= t.nav.aboutMenu.testimonials %></a>
          </div>
        </div>

        <div class="nav-item">
          <button class="nav-link nav-trigger" type="button"><i class="nav-icon fas fa-palette"></i><%= t.nav.exhibits %></button>
          <div class="dropdown">
            <a href="/exhibits/pharaoh" class="dropdown-link"><i class="dropdown-icon fas fa-crown"></i><%= t.nav.exhibitsMenu.pharaoh %></a>
            <a href="/exhibits/islamic" class="dropdown-link"><i class="dropdown-icon fas fa-mosque"></i><%= t.nav.exhibitsMenu.islamic %></a>
            <a href="/exhibits/christian" class="dropdown-link"><i class="dropdown-icon fas fa-church"></i><%= t.nav.exhibitsMenu.christian %></a>
          </div>
        </div>

        <div class="nav-item">
          <button class="nav-link nav-trigger" type="button"><i class="nav-icon fas fa-vr-cardboard"></i><%= t.nav.virtualTour %></button>
          <div class="dropdown">
            <a href="/virtual-tour/pharaoh" class="dropdown-link"><i class="dropdown-icon fas fa-crown"></i><%= t.nav.virtualTourMenu.pharaoh %></a>
            <a href="/virtual-tour/islamic" class="dropdown-link"><i class="dropdown-icon fas fa-star-and-crescent"></i><%= t.nav.virtualTourMenu.islamic %></a>
            <a href="/virtual-tour/christian" class="dropdown-link"><i class="dropdown-icon fas fa-book-bible"></i><%= t.nav.virtualTourMenu.christian %></a>
            <a href="/vr-experience" class="dropdown-link"><i class="dropdown-icon fas fa-vr-cardboard"></i><%= language === "ar" ? "تجربة الواقع الافتراضي" : "VR Experience" %></a>
          </div>
        </div>

        <div class="nav-item">
          <button class="nav-link nav-trigger" type="button"><i class="nav-icon fas fa-gamepad"></i><%= t.nav.games %></button>
          <div class="dropdown">
            <a href="/games/quiz" class="dropdown-link"><i class="dropdown-icon fas fa-circle-question"></i><%= t.nav.gamesMenu.quiz %></a>
            <a href="/games/explorer" class="dropdown-link"><i class="dropdown-icon fas fa-compass"></i><%= t.nav.gamesMenu.explorer %></a>
            <a href="/games/pyramid" class="dropdown-link"><i class="dropdown-icon fas fa-mountain"></i><%= t.nav.gamesMenu.pyramid %></a>
          </div>
        </div>

        <div class="nav-item">
          <button class="nav-link nav-trigger" type="button"><i class="nav-icon fas fa-shopping-bag"></i><%= t.nav.shop %></button>
          <div class="dropdown">
            <a href="/shop?type=books" class="dropdown-link"><i class="dropdown-icon fas fa-book"></i><%= t.nav.shopMenu.books %></a>
            <a href="/shop?type=souvenirs" class="dropdown-link"><i class="dropdown-icon fas fa-gift"></i><%= t.nav.shopMenu.souvenirs %></a>
            <a href="/cart" class="dropdown-link"><i class="dropdown-icon fas fa-cart-shopping"></i><%= t.nav.shopMenu.cart %></a>
          </div>
        </div>

          <a href="/plan-trip" class="nav-link"><i class="nav-icon fas fa-calendar-alt"></i><%= t.nav.planTrip %></a>
        </nav>
        <div class="nav-backdrop" id="nav-backdrop" aria-hidden="true"></div>
      </div>
    </div>
  </div>
</header>
