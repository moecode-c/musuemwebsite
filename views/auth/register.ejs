<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<style>
  .input-field { position: relative; }
  .input-field:has(.password-toggle) input { padding-right: 42px; }
  .password-toggle {
    position: absolute;
    inset-inline-end: 10px;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--text-muted, #8a7b9a);
    font-size: 1rem;
    padding: 4px;
    display: inline-flex;
    align-items: center;
  }
  .password-toggle:hover { color: var(--accent, #b48b2f); }
</style>

<section class="auth-section">
  <div class="container auth-layout">
    <div class="auth-panel">
      <p class="auth-eyebrow"><%= language === 'ar' ? 'انضم إلى المجتمع' : 'Join the community' %></p>
      <h1><%= language === 'ar' ? 'ابدأ رحلتك مع المتحف' : 'Start your museum journey' %></h1>
      <p class="auth-subtitle"><%= language === 'ar' ? 'أنشئ حساباً لحفظ المفضلة وحجز التذاكر والحصول على التحديثات.' : 'Create an account to save favorites, book tickets, and get updates.' %></p>
      <div class="auth-highlights">
        <div>
          <i class="fa-solid fa-star"></i>
          <span><%= language === 'ar' ? 'قوائم معروضات مختارة' : 'Curated exhibit lists' %></span>
        </div>
        <div>
          <i class="fa-solid fa-calendar-days"></i>
          <span><%= language === 'ar' ? 'وصول مبكر للفعاليات' : 'Early event access' %></span>
        </div>
        <div>
          <i class="fa-solid fa-globe"></i>
          <span><%= language === 'ar' ? 'تذكيرات الجولة الافتراضية' : 'Virtual tour reminders' %></span>
        </div>
      </div>
    </div>
    <div class="auth-card">
      <div class="auth-card-header">
        <span class="auth-badge"><%= language === 'ar' ? 'إنشاء حساب' : 'Create account' %></span>
        <h2><%= language === 'ar' ? 'التسجيل' : 'Register' %></h2>
        <p><%= language === 'ar' ? 'أدخل بياناتك للبدء.' : 'Fill in the details below to get started.' %></p>
      </div>
      <form class="auth-form" id="register-form" autocomplete="on" data-validate="true" novalidate>
        <div class="input-group">
          <label for="register-name"><%= language === 'ar' ? 'الاسم' : 'Name' %></label>
          <div class="input-field">
            <i class="fa-regular fa-user"></i>
            <input id="register-name" type="text" name="name" autocomplete="name" placeholder="<%= language === 'ar' ? 'اسمك الكامل' : 'Your full name' %>" required />
          </div>
        </div>
        <div class="input-group">
          <label for="register-email"><%= language === 'ar' ? 'البريد الإلكتروني' : 'Email' %></label>
          <div class="input-field">
            <i class="fa-regular fa-envelope"></i>
            <input id="register-email" type="email" name="email" autocomplete="email" placeholder="you@example.com" required />
          </div>
        </div>
        <div class="input-group">
          <label for="register-password"><%= language === 'ar' ? 'كلمة المرور' : 'Password' %></label>
          <div class="input-field">
            <i class="fa-solid fa-lock"></i>
            <input id="register-password" type="password" name="password" autocomplete="new-password" placeholder="<%= language === 'ar' ? 'أنشئ كلمة مرور' : 'Create a password' %>" required />
            <button type="button" class="password-toggle" data-password-toggle aria-label="<%= language === 'ar' ? 'إظهار كلمة المرور' : 'Show password' %>"><i class="fa-solid fa-eye"></i></button>
          </div>
        </div>
        <button class="btn auth-submit" type="submit"><%= language === 'ar' ? 'تسجيل' : 'Register' %></button>
        <p class="form-message" id="register-message"></p>
      </form>
      <div class="auth-footer">
        <span><%= language === 'ar' ? 'لديك حساب بالفعل؟' : 'Already have an account?' %></span>
        <a href="/auth/login"><%= language === 'ar' ? 'تسجيل الدخول' : 'Sign in' %></a>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>