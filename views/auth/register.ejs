<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<section class="auth-section">
  <div class="container auth-layout">
    <div class="auth-panel">
      <p class="auth-eyebrow">Join the community</p>
      <h1>Start your museum journey</h1>
      <p class="auth-subtitle">Create an account to save favorites, book tickets, and get updates.</p>
      <div class="auth-highlights">
        <div>
          <i class="fa-solid fa-star"></i>
          <span>Curated exhibit lists</span>
        </div>
        <div>
          <i class="fa-solid fa-calendar-days"></i>
          <span>Early event access</span>
        </div>
        <div>
          <i class="fa-solid fa-globe"></i>
          <span>Virtual tour reminders</span>
        </div>
      </div>
    </div>

    <div class="auth-card">
      <div class="auth-card-header">
        <span class="auth-badge">Create account</span>
        <h2>Register</h2>
        <p>Fill in the details below to get started.</p>
      </div>

      <form class="auth-form" id="register-form">
        <div class="input-group">
          <label for="register-name">Name</label>
          <div class="input-field">
            <i class="fa-regular fa-user"></i>
            <input id="register-name" type="text" name="name" placeholder="Your full name" required />
          </div>
        </div>
        <div class="input-group">
          <label for="register-email">Email</label>
          <div class="input-field">
            <i class="fa-regular fa-envelope"></i>
            <input id="register-email" type="email" name="email" placeholder="you@example.com" required />
          </div>
        </div>
        <div class="input-group">
          <label for="register-password">Password</label>
          <div class="input-field">
            <i class="fa-solid fa-lock"></i>
            <input id="register-password" type="password" name="password" placeholder="Create a password" required />
          </div>
        </div>
        <button class="btn auth-submit" type="submit">Register</button>
        <p class="form-message" id="register-message"></p>
      </form>

      <div class="auth-footer">
        <span>Already have an account?</span>
        <a href="/auth/login">Sign in</a>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
