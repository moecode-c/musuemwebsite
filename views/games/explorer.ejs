<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<style>
  .page-pyramid-builder #explorer-frame {
    width: 100%;
    max-width: 1024px;
    aspect-ratio: 16 / 9;
    margin: 0 auto;
  }

  .page-pyramid-builder #explorer-frame iframe {
    width: 100%;
    height: 100%;
    display: block;
    background: #000;
  }

  .page-pyramid-builder #explorer-frame:fullscreen {
    width: 100vw;
    height: 100vh;
    max-width: none;
    aspect-ratio: auto;
    border-radius: 0;
  }

  .page-pyramid-builder #explorer-frame:fullscreen iframe {
    width: 100%;
    height: 100%;
  }
</style>

<section class="page-hero">
  <div class="container">
    <h1><%= t?.explorer?.title || "Explorer Game" %></h1>
    <p><%= t?.explorer?.subtitle || "Explore the map in a framed game view, just like Pyramid Builder." %></p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="game-panel">
      <div class="game-info">
        <h2>Explore the world</h2>
        <p>
          Move through the map and discover the environment. The game runs inside this frame while the
          rest of your normal page layout stays the same.
        </p>
        <div class="game-tips">
          <h3>How to play</h3>
          <ul>
            <li>Click inside the game frame to focus it.</li>
            <li>Move with <strong>W</strong>, <strong>A</strong>, <strong>S</strong>, <strong>D</strong>.</li>
            <li>Press <strong>P</strong> to toggle collision debug in-game.</li>
          </ul>
        </div>
      </div>

      <div class="game-frame" id="explorer-frame" aria-label="Explorer Game">
        <button class="icon-btn" type="button" id="explorer-fullscreen" aria-label="Toggle full screen">
          <i class="fas fa-expand"></i>
        </button>
        <iframe
          src="/assets/explorer-game/index.html"
          title="Explorer Game"
          style="border: 0;"
          loading="lazy"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    const frame = document.getElementById("explorer-frame");
    const button = document.getElementById("explorer-fullscreen");
    if (!frame || !button) return;

    const updateIcon = () => {
      const icon = button.querySelector("i");
      if (!icon) return;
      const isFullscreen = document.fullscreenElement === frame;
      icon.classList.toggle("fa-expand", !isFullscreen);
      icon.classList.toggle("fa-compress", isFullscreen);
    };

    button.addEventListener("click", async () => {
      try {
        if (document.fullscreenElement === frame) {
          await document.exitFullscreen();
        } else {
          await frame.requestFullscreen();
        }
      } catch (error) {
        console.error(error);
      }
    });

    document.addEventListener("fullscreenchange", updateIcon);
    updateIcon();
  })();
</script>

<%- include('../partials/footer') %>
