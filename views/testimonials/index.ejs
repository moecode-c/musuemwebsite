<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<section class="page-hero">
  <div class="container">
    <h1>Testimonials</h1>
    <p>Real stories from visitors who explored the heart of Egypt.</p>
  </div>
</section>

<section class="section">
  <div class="container split">
    <div>
      <div class="testimonials-summary">
        <div>
          <h2>Visitor Highlights</h2>
          <p>Every review helps us create more meaningful experiences for future visitors.</p>
        </div>
        <div class="rating-badge">
          <span class="rating-score">4.9</span>
          <span class="rating-text">Average rating</span>
        </div>
      </div>
      <div class="grid">
        <%- testimonialsHtml %>
      </div>
    </div>
    <form class="form" id="testimonial-form">
      <h3>Share your experience</h3>
      <label>Name</label>
      <input type="text" name="name" required />
      <label>Message</label>
      <textarea name="message" required></textarea>
      <label>Rating (1-5)</label>
      <input type="number" name="rating" min="1" max="5" value="5" required />
      <button class="btn" type="submit">Submit</button>
      <p class="form-message" id="testimonial-message"></p>
    </form>
  </div>
</section>

<%- include('../partials/footer') %>
