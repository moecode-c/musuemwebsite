<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<section class="page-hero">
  <div class="container">
    <h1><%= t.testimonials.title %></h1>
    <p><%= t.testimonials.subtitle %></p>
  </div>
</section>

<section class="section">
  <div class="container split">
    <div>
      <div class="testimonials-summary">
        <div>
          <h2><%= t.testimonials.highlightsTitle %></h2>
          <p><%= t.testimonials.highlightsText %></p>
        </div>
        <div class="rating-badge">
          <span class="rating-score">4.9</span>
          <span class="rating-text"><%= t.testimonials.averageRating %></span>
        </div>
      </div>
      <div class="grid">
        <%- testimonialsHtml %>
      </div>
    </div>
    <form class="form" id="testimonial-form">
      <h3><%= t.testimonials.formTitle %></h3>
      <label><%= t.testimonials.name %></label>
      <input type="text" name="name" required />
      <label><%= t.testimonials.message %></label>
      <textarea name="message" required></textarea>
      <label><%= t.testimonials.rating %></label>
      <input type="number" name="rating" min="1" max="5" value="5" required />
      <button class="btn" type="submit"><%= t.testimonials.submit %></button>
      <p class="form-message" id="testimonial-message"></p>
    </form>
  </div>
</section>

<%- include('../partials/footer') %>