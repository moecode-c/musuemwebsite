<%- include('../partials/employeeLayoutStart') %>
<section>
  <h1><i class="fas fa-landmark"></i> <%= language === 'ar' ? 'لوحة تحكم أمين المعرض' : 'Curator Dashboard' %></h1>
  <p><%= language === 'ar' ? `مرحباً، ${employeeName}. اعرض مهام إعداد المعروضات والمجموعات وحدّثها.` : `Welcome, ${employeeName}. View and update your exhibit preparation and collection tasks.` %></p>
  <article class="card">
    <h3><i class="fas fa-clipboard-list"></i> <%= language === 'ar' ? 'مهامي المعينة' : 'My Assigned Tasks' %></h3>
    <p><%= language === 'ar' ? 'تحقق من مهام المعروضات والقطع الأثرية الحالية.' : 'Check your current exhibit and artifact handling tasks.' %></p>
    <div class="map-wrapper admin-map" data-employee-zone-map>
      <img src="/assets/map/map.png" alt="<%= language === 'ar' ? 'خريطة المتحف' : 'Museum map' %>" class="map-image" />
      <div class="map-layer"></div>
    </div>
    <div class="admin-list" data-employee-task-list></div>
  </article>
  <article class="card">
    <h3><i class="fas fa-map-location-dot"></i> <%= language === 'ar' ? 'مناطقي المعينة' : 'My Assigned Zones' %></h3>
    <p><%= language === 'ar' ? 'المناطق المخصصة لك في المتحف.' : 'Zones assigned to you across the museum.' %></p>
    <div class="map-wrapper admin-map" data-employee-zone-map>
      <img src="/assets/map/map.png" alt="<%= language === 'ar' ? 'خريطة المتحف' : 'Museum map' %>" class="map-image" />
      <div class="map-layer"></div>
    </div>
    <div class="admin-list" data-employee-zone-list></div>
  </article>
</section>
<%- include('../partials/employeeLayoutEnd') %>