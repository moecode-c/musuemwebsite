<%- include('../partials/employeeLayoutStart') %>
<section>
  <h1><i class="fas fa-concierge-bell"></i> <%= language === 'ar' ? 'لوحة تحكم الاستقبال' : 'Front Desk Dashboard' %></h1>
  <p><%= language === 'ar' ? `مرحباً، ${employeeName}. أدر طابور الانتظار ومهام دعم الزوار وطلبات الاستقبال.` : `Welcome, ${employeeName}. Manage queue, visitor support tasks, and front desk requests.` %></p>
  <article class="card">
    <h3><i class="fas fa-users"></i> <%= language === 'ar' ? 'مهام دعم الزوار' : 'Visitor Support Tasks' %></h3>
    <p><%= language === 'ar' ? 'راجع مهام الاستقبال المفتوحة وأولوياتها.' : 'Review open front-desk assignments and priorities.' %></p>
    <div class="map-wrapper admin-map" data-employee-zone-map>
      <img src="/assets/map/map.png" alt="<%= language === 'ar' ? 'خريطة المتحف' : 'Museum map' %>" class="map-image" />
      <div class="map-layer"></div>
    </div>
    <div class="admin-list" data-employee-task-list></div>
  </article>
  <article class="card">
    <h3><i class="fas fa-map-location-dot"></i> <%= language === 'ar' ? 'مناطقي المعينة' : 'My Assigned Zones' %></h3>
    <p><%= language === 'ar' ? 'المناطق المخصصة لك في المتحف.' : 'Zones assigned to you across the museum.' %></p>
    <div class="map-wrapper admin-map" data-employee-zone-map>
      <img src="/assets/map/map.png" alt="<%= language === 'ar' ? 'خريطة المتحف' : 'Museum map' %>" class="map-image" />
      <div class="map-layer"></div>
    </div>
    <div class="admin-list" data-employee-zone-list></div>
  </article>
</section>
<%- include('../partials/employeeLayoutEnd') %>