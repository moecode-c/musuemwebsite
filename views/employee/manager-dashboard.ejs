<%- include('../partials/employeeLayoutStart') %>
<section id="manager-dashboard">
  <header class="admin-page-header">
    <div>
      <h1><i class="fas fa-user-tie"></i> <%= t.manager.title %></h1>
      <p><%= t.manager.welcome %>, <%= employeeName %>. <%= t.manager.subtitle %></p>
    </div>
  </header>
  <div class="admin-grid">
    <article class="admin-card">
      <h3><i class="fas fa-list-check"></i> <%= t.manager.taskManagement %></h3>
      <p><%= t.manager.taskDescription %></p>
      <a class="btn" href="/employee/manager/tasks"><%= t.manager.openTasks %></a>
    </article>
    <article class="admin-card">
      <h3><i class="fas fa-map"></i> <%= t.manager.zoneManagement %></h3>
      <p><%= t.manager.zoneDescription %></p>
      <a class="btn" href="/employee/manager/zones"><%= t.manager.openZones %></a>
    </article>
  </div>
</section>
<%- include('../partials/employeeLayoutEnd') %>