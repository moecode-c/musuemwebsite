<%- include('../partials/employeeLayoutStart') %>

<section id="manager-dashboard">
  <header class="admin-page-header">
    <div>
      <h1><i class="fas fa-user-tie"></i> Museum Manager Dashboard</h1>
      <p>Welcome, <%= employeeName %>. Use separate pages to manage tasks and cleaning zones.</p>
    </div>
  </header>

  <div class="admin-grid">
    <article class="admin-card">
      <h3><i class="fas fa-list-check"></i> Task Management</h3>
      <p>Create assignments, set priority, add checklists, and track all employee task statuses.</p>
      <a class="btn" href="/employee/manager/tasks">Open Task Management</a>
    </article>

    <article class="admin-card">
      <h3><i class="fas fa-map"></i> Zone Management</h3>
      <p>Create cleaning zones on the map and assign janitors without mixing this with task forms.</p>
      <a class="btn" href="/employee/manager/zones">Open Zone Management</a>
    </article>
  </div>
</section>

<%- include('../partials/employeeLayoutEnd') %>
