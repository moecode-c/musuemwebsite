<%- include('../partials/employeeLayoutStart') %>
<section>
  <h1><i class="fas fa-chalkboard-teacher"></i> <%= language === 'ar' ? 'لوحة تحكم المرشد التعليمي' : 'Educator Dashboard' %></h1>
  <p><%= language === 'ar' ? `مرحباً، ${employeeName}. أدر مهام الجولات وورش العمل والدورات.` : `Welcome, ${employeeName}. Manage tour, workshop, and session support tasks.` %></p>
  <article class="card">
    <h3><i class="fas fa-book-open-reader"></i> <%= language === 'ar' ? 'مهام الدورات' : 'Session Tasks' %></h3>
    <p><%= language === 'ar' ? 'راجع مهام التحضير والتنفيذ والمتابعة للدورات التعليمية.' : 'Review assigned preparation, delivery, and follow-up tasks for educational sessions.' %></p>
    <div class="map-wrapper admin-map" data-employee-zone-map>
      <img src="/assets/map/map.png" alt="<%= language === 'ar' ? 'خريطة المتحف' : 'Museum map' %>" class="map-image" />
      <div class="map-layer"></div>
    </div>
    <div class="admin-list" data-employee-task-list></div>
  </article>
  <article class="card">
    <h3><i class="fas fa-map-location-dot"></i> <%= language === 'ar' ? 'مناطقي المعينة' : 'My Assigned Zones' %></h3>
    <p><%= language === 'ar' ? 'المناطق المخصصة لك في المتحف.' : 'Zones assigned to you across the museum.' %></p>
    <div class="map-wrapper admin-map" data-employee-zone-map>
      <img src="/assets/map/map.png" alt="<%= language === 'ar' ? 'خريطة المتحف' : 'Museum map' %>" class="map-image" />
      <div class="map-layer"></div>
    </div>
    <div class="admin-list" data-employee-zone-list></div>
  </article>
</section>
<%- include('../partials/employeeLayoutEnd') %>