<%
  const isArabic = language === "ar";
  const homePageI18n = isArabic
    ? {
      viewLabelPrefix: "عرض",
      goToLabelPrefix: "اذهب إلى",
      galleryPageLabel: "اذهب إلى صفحة المعرض",
      readMore: "اقرأ المزيد",
      readLess: "عرض أقل",
      pauseHintDefault: "انقر للإيقاف المؤقت ثم انقر مرة أخرى للاستئناف",
      pauseHintPaused: "متوقف مؤقتا - انقر للاستئناف",
      destinations: [
        {
          name: "أهرامات الجيزة",
          title: "الأهرامات",
          eyebrow: "الدولة القديمة - 2580 ق.م",
          desc: "تنهض من رمال صحراء الجيزة، وقد ظلت الهرم الأكبر أعلى بناء صنعه الإنسان لما يقارب 4,000 عام. إنه المقبرة الملكية للفرعون خوفو وآخر عجائب العالم القديم الباقية حتى اليوم.",
          img: "/assets/images/pyramidsbg.png"
        },
        {
          name: "قناع توت عنخ آمون",
          title: "قناع توت",
          eyebrow: "الدولة الحديثة - 1323 ق.م",
          desc: "صنع من 11 كجم من الذهب الخالص ومطعم بحجر اللازورد، ويعد القناع الجنائزي للملك الصغير أحد أشهر آثار العصور القديمة. اكتشفه هوارد كارتر عام 1922 ويعرض اليوم في المتحف المصري.",
          img: "/assets/images/tut1.png"
        },
        {
          name: "أبو الهول العظيم",
          title: "أبو الهول",
          eyebrow: "الدولة القديمة - 2500 ق.م",
          desc: "حارس هائل من الحجر الجيري بجسد أسد ووجه فرعون. يطل أبو الهول على النيل منذ آلاف السنين حاملا أسرارا لا تزال تحير علماء الآثار.",
          img: "/assets/images/sph1.png"
        },
        {
          name: "معبد الكرنك",
          title: "الكرنك",
          eyebrow: "الدولة الوسطى - 2000 ق.م",
          desc: "مجمع ديني ضخم مكرس للإله آمون رع. وتظل قاعة الأعمدة الكبرى - بغابتها المكونة من 134 عمودا حجريا شاهقا - من أكثر المساحات المعمارية إدهاشا في التاريخ.",
          img: "/assets/images/karnak.png"
        },
        {
          name: "أبو سمبل",
          title: "أبو سمبل",
          eyebrow: "الدولة الحديثة - 1264 ق.م",
          desc: "نحت المعبدان التوأمان لرمسيس الثاني مباشرة في جرف رملي، ثم أعيد نقلهما حجرا حجرا في ستينيات القرن الماضي لإنقاذهما من مياه الفيضان. ولا تزال التماثيل الأربعة العملاقة تحرس المدخل حتى اليوم.",
          img: "/assets/images/abu1.png"
        },
        {
          name: "وادي الملوك",
          title: "الوادي",
          eyebrow: "الدولة الحديثة - 1500 ق.م",
          desc: "في منحدرات الضفة الغربية للأقصر تختبئ مقابر أقوى فراعنة مصر. ثلاث وستون حجرة منحوتة في الصخر، مزينة بمشاهد زاهية لرحلة ما بعد الحياة.",
          img: "/assets/images/valley.png"
        }
      ]
    }
    : {};
%>
<%- include('partials/header') %>
<%- include('partials/navbar') %>

<section class="hero-section">
  <div class="bg-stage" id="bgStage"></div>
  <div class="bg-overlay"></div>

  <div class="brand"><%= isArabic ? "متحف" : "The" %> <span><%= isArabic ? "الحياة الأخرى" : "Afterlife" %></span> <%= isArabic ? "" : "Museum" %></div>
  <div class="timeline" id="timeline"></div>

  <div class="frame">
    <div class="content" id="content">
      <div class="eyebrow" id="eyebrow"><%= isArabic ? "المتحف المصري - القاهرة" : "Egyptian Museum - Cairo" %></div>
      <h1 class="title" id="title"><%= isArabic ? "الأهرامات" : "PYRAMIDS" %></h1>
      <p class="desc" id="desc"><%= isArabic ? "جار التحميل..." : "Loading..." %></p>
      <a class="explore-btn" href="/exhibits/pharaoh" aria-label="<%= isArabic ? 'استكشف معروض الفراعنة' : 'Explore the Pharaoh exhibit' %>">
        <%= isArabic ? "استكشف" : "Explore" %> <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
    <div class="cards-wrap" id="cardsWrap"></div>
  </div>

  <div class="corner"><span id="counterCur">01</span> / <span id="counterTotal">06</span></div>
  <div class="controls">
    <button class="ctrl" id="prevBtn" aria-label="<%= isArabic ? 'المعروض السابق' : 'Previous exhibit' %>">‹</button>
    <button class="ctrl" id="nextBtn" aria-label="<%= isArabic ? 'المعروض التالي' : 'Next exhibit' %>">›</button>
  </div>
</section>

<section class="about-section" id="about">
  <div class="about-grid">
    <div class="about-video-wrap">
      <video
        src="/assets/videos/homepagevid.mp4"
        autoplay
        muted
        loop
        playsinline
        aria-label="Museum interior footage"
      ></video>
    </div>
    <div class="about-text">
      <div class="about-eyebrow"><%= isArabic ? "متحف الحياة الأخرى - القاهرة" : "The Afterlife Museum - Cairo" %></div>
      <h2 class="about-heading"><%= isArabic ? "حراس إرث خالد" : "Guardians of an Eternal Legacy" %></h2>
      <p class="about-desc">
        <%= isArabic
          ? "ادخل إلى عالم ما زالت فيه همسات الفراعنة تتردد عبر الحجر والذهب. يضم متحفنا أكبر مجموعة من الآثار المصرية، من القناع الذهبي للملك الصغير إلى التماثيل العملاقة لعصر الدولة الحديثة. كل قطعة أثرية هي بوابة إلى حضارة شكلت العالم."
          : "Step inside a world where pharaohs still whisper through stone and gold. Our museum holds the largest collection of Egyptian antiquities — from the boy king's golden mask to the colossal statues of the New Kingdom. Every artifact is a doorway to a civilization that shaped the world."
        %>
      </p>
      <div class="about-mini-photos">
        <div class="about-mini-photo" style="background-image:url('/assets/images/tut1.png')" role="img" aria-label="Tutankhamun exhibit"></div>
        <div class="about-mini-photo" style="background-image:url('/assets/images/sph1.png')" role="img" aria-label="Great Sphinx exhibit"></div>
      </div>
      <a class="about-cta" href="/exhibits/pharaoh" aria-label="<%= isArabic ? 'اكتشف المزيد عن المتحف' : 'Discover more about the museum' %>"><%= isArabic ? "اكتشف المزيد" : "Discover More" %></a>
    </div>
  </div>
</section>

<section class="spotlight-wrap">
  <div class="spotlight-section">
    <div class="spotlight-kicker"><%= isArabic ? "متحف الحياة الأخرى - القاهرة" : "The Afterlife Museum - Cairo" %></div>
    <h2 class="spotlight-title"><%= isArabic ? "أوديسة افتراضية" : "Virtual Odyssey" %></h2>
    <p class="spotlight-text">
      <%= isArabic
        ? "انطلق في جولة افتراضية إرشادية عبر القاعات. قرّب المعروضات، واستكشف قاعات 360 درجة، وتجول في المتحف من أي مكان في العالم."
        : "Take a guided virtual tour through the galleries. Zoom into artifacts, explore 360-degree halls, and walk the museum from anywhere in the world."
      %>
    </p>
    <a class="spotlight-btn" href="/vr-experience" aria-label="<%= isArabic ? 'ابدأ الجولة الافتراضية' : 'Start virtual tour' %>"><%= isArabic ? "اكتشف المزيد" : "Discover More" %></a>
  </div>
</section>

<div class="section-divider" role="presentation"></div>

<section class="shop-section">
  <div class="shop-layout">
    <div class="shop-gallery" aria-label="Shop gallery">
      <div class="shop-img wide" style="background-image:url('/assets/images/valley.png')" role="img" aria-label="Valley of the Kings"></div>
      <div class="shop-img" style="background-image:url('/assets/images/sph1.png')" role="img" aria-label="Sphinx"></div>
      <div class="shop-img" style="background-image:url('/assets/images/tut1.png')" role="img" aria-label="Tutankhamun"></div>
      <div class="shop-img wide" style="background-image:url('/assets/images/karnak.png')" role="img" aria-label="Karnak Temple"></div>
    </div>

    <div class="shop-divider" aria-hidden="true">
      <div class="shop-glyph">𓂀 𓆣 𓇋 𓅓 𓋹 𓇗</div>
    </div>

    <div class="shop-content">
      <h2 class="shop-title"><%= isArabic ? "متجر المتحف" : "Museum Shop" %></h2>
      <p class="shop-text">
        <%= isArabic
          ? "نسخ مختارة بعناية، ومجوهرات حرفية، ومطبوعات عصرية مستوحاة من الزخارف القديمة. خذ معك قطعة من الحكاية إلى منزلك."
          : "Curated replicas, artisan jewelry, and modern prints inspired by ancient motifs. Bring a piece of the story home."
        %>
      </p>
      <a class="shop-btn" href="/shop" aria-label="<%= isArabic ? 'زر متجر المتحف' : 'Visit the museum shop' %>"><%= isArabic ? "زيارة المتجر" : "Visit Shop" %></a>
    </div>
  </div>
</section>

<section class="gallery-wrap">
  <div class="gallery-section">
    <h2 class="gallery-title"><%= isArabic ? "معرض الصور" : "Photo Gallery" %></h2>
    <div class="gallery-block">
      <div class="gallery-slider" aria-label="Photo gallery slider" role="region">
        <div class="slider-track" id="sliderTrack">
          <div class="slider-page" role="group" aria-label="Gallery page 1">
            <div class="slide-tile gallery-item-1" style="background-image:url('/assets/images/pyramidsbg.png')" role="img" aria-label="Pyramids at sunset"></div>
            <div class="slide-tile gallery-item-2" style="background-image:url('/assets/images/bg1.jpeg')" role="img" aria-label="Egyptian landscape"></div>
            <div class="slide-tile gallery-item-3" style="background-image:url('/assets/images/karnak.png')" role="img" aria-label="Temple columns"></div>
            <div class="slide-tile gallery-item-4" style="background-image:url('/assets/images/valley.png')" role="img" aria-label="Nile River"></div>
            <div class="slide-tile gallery-item-5" style="background-image:url('/assets/images/Christian%209.jpg')" role="img" aria-label="Saint Catherine's Monastery"></div>
            <div class="slide-tile gallery-item-6" style="background-image:url('/assets/images/bg2.jpeg')" role="img" aria-label="Egypt landscape"></div>
            <div class="slide-tile gallery-item-7" style="background-image:url('/assets/images/desertmap.png')" role="img" aria-label="Desert dunes"></div>
            <div class="slide-tile gallery-item-8" style="background-image:url('/assets/images/image11.jpg')" role="img" aria-label="Ancient ruins"></div>
          </div>

          <div class="slider-page" role="group" aria-label="Gallery page 2">
            <div class="slide-tile gallery-item-1" style="background-image:url('/assets/images/sph1.png')" role="img" aria-label="Great Sphinx"></div>
            <div class="slide-tile gallery-item-2" style="background-image:url('/assets/images/karnak.png')" role="img" aria-label="Karnak Temple"></div>
            <div class="slide-tile gallery-item-3" style="background-image:url('/assets/images/pyramidsbg.png')" role="img" aria-label="Pyramids of Giza"></div>
            <div class="slide-tile gallery-item-4" style="background-image:url('/assets/images/abu1.png')" role="img" aria-label="Abu Simbel"></div>
            <div class="slide-tile gallery-item-5" style="background-image:url('/assets/images/valley.png')" role="img" aria-label="Valley of the Kings"></div>
            <div class="slide-tile gallery-item-6" style="background-image:url('/assets/images/tut1.png')" role="img" aria-label="Tutankhamun's Mask"></div>
            <div class="slide-tile gallery-item-7" style="background-image:url('/assets/images/sph1.png')" role="img" aria-label="Sphinx close-up"></div>
            <div class="slide-tile gallery-item-8" style="background-image:url('/assets/images/karnak.png')" role="img" aria-label="Temple hypostyle hall"></div>
          </div>

          <div class="slider-page" role="group" aria-label="Gallery page 3">
            <div class="slide-tile gallery-item-1" style="background-image:url('/assets/images/abu1.png')" role="img" aria-label="Abu Simbel facade"></div>
            <div class="slide-tile gallery-item-2" style="background-image:url('/assets/images/valley.png')" role="img" aria-label="Valley at dusk"></div>
            <div class="slide-tile gallery-item-3" style="background-image:url('/assets/images/tut1.png')" role="img" aria-label="Golden mask detail"></div>
            <div class="slide-tile gallery-item-4" style="background-image:url('/assets/images/pyramidsbg.png')" role="img" aria-label="Pyramid at dawn"></div>
            <div class="slide-tile gallery-item-5" style="background-image:url('/assets/images/karnak.png')" role="img" aria-label="Karnak corridor"></div>
            <div class="slide-tile gallery-item-6" style="background-image:url('/assets/images/sph1.png')" role="img" aria-label="Sphinx profile"></div>
            <div class="slide-tile gallery-item-7" style="background-image:url('/assets/images/abu1.png')" role="img" aria-label="Ramesses statues"></div>
            <div class="slide-tile gallery-item-8" style="background-image:url('/assets/images/valley.png')" role="img" aria-label="Valley tomb entrance"></div>
          </div>
        </div>

        <div class="slider-controls">
          <button class="slider-btn" type="button" id="sliderPrev" aria-label="<%= isArabic ? 'صفحة المعرض السابقة' : 'Previous gallery page' %>">‹</button>
          <button class="slider-btn" type="button" id="sliderNext" aria-label="<%= isArabic ? 'صفحة المعرض التالية' : 'Next gallery page' %>">›</button>
        </div>
        <div class="gallery-dots" id="galleryDots" role="tablist" aria-label="<%= isArabic ? 'صفحات المعرض' : 'Gallery pages' %>"></div>
      </div>
    </div>
  </div>
</section>

<div class="section-divider" role="presentation"></div>

<section class="reviews-section">
  <div class="reviews-stage">
    <header class="reviews-header">
      <div class="reviews-title"><%= isArabic ? "ماذا يقول الزوار" : "What Visitors Say" %></div>
      <div class="reviews-title-line"></div>
    </header>

    <div class="reviews-slider" id="reviewsSlider" aria-label="Visitor reviews" role="region">
      <div class="reviews-track" id="reviewsTrack">
        <article class="reviews-slide">
          <div class="review-card">
            <div class="review-photo-banner" style="background-image:url('/assets/images/bg2.png')" role="img" aria-label="Cairo skyline"></div>
            <div class="review-avatar-wrap">
              <div class="review-avatar" style="background-image:url('/assets/images/image1.jpeg')" role="img" aria-label="Isabella's photo"></div>
            </div>
            <div class="review-body">
              <div class="review-name">Isabella</div>
              <div class="review-meta">22 June 2021</div>
              <div class="review-stars" aria-label="5 stars">★★★★★</div>
              <div class="review-divider"></div>
              <p class="review-text">
                <%= isArabic
                  ? "كانت التجربة رائعة ومريحة ومبهرة. أنصح بها كل من يهتم بالتاريخ القديم والثقافة المصرية. ألوان كل معروض وتفاصيله كانت مدهشة بشكل لا يوصف ولم أشاهد مثلها من قبل."
                  : "Really nice, relaxing and impressive. Would recommend to everyone who is interested in ancient history and Egyptian culture. The colors and textures of every exhibit were so incredibly interesting — unlike anything I have ever experienced."
                %>
              </p>
              <button class="review-link" type="button" aria-expanded="false"><%= isArabic ? "اقرأ المزيد" : "Read more" %></button>
            </div>
          </div>
        </article>

        <article class="reviews-slide">
          <div class="review-card">
            <div class="review-photo-banner" style="background-image:url('/assets/images/pillarsbg.png')" role="img" aria-label="Pyramids view"></div>
            <div class="review-avatar-wrap">
              <div class="review-avatar" style="background-image:url('/assets/images/image3.jpeg')" role="img" aria-label="Mara's photo"></div>
            </div>
            <div class="review-body">
              <div class="review-name">Mara</div>
              <div class="review-meta">03 November 2021</div>
              <div class="review-stars" aria-label="5 stars">★★★★★</div>
              <div class="review-divider"></div>
              <p class="review-text">
                <%= isArabic
                  ? "المناظر كانت تخطف الأنفاس. كل قاعة شعرت كأنها لوحة جديدة. هدوء وسكينة وتجربة لا تنسى. قام القيمون على المتحف بعمل استثنائي جعل التاريخ القديم حيا وقريبا جدا."
                  : "The scenery was breathtaking. Every gallery felt like entering a new painting. Quiet, peaceful, unforgettable. The curators have done an extraordinary job making ancient history feel alive and immediate."
                %>
              </p>
              <button class="review-link" type="button" aria-expanded="false"><%= isArabic ? "اقرأ المزيد" : "Read more" %></button>
            </div>
          </div>
        </article>

        <article class="reviews-slide">
          <div class="review-card">
            <div class="review-photo-banner" style="background-image:url('/assets/images/islamic%20bg.jpg')" role="img" aria-label="Egypt monument"></div>
            <div class="review-avatar-wrap">
              <div class="review-avatar" style="background-image:url('/assets/images/image4.jpeg')" role="img" aria-label="Elena's photo"></div>
            </div>
            <div class="review-body">
              <div class="review-name">Elena</div>
              <div class="review-meta">14 April 2022</div>
              <div class="review-stars" aria-label="5 stars">★★★★★</div>
              <div class="review-divider"></div>
              <p class="review-text">
                <%= isArabic
                  ? "إيقاع الجولة كان مثاليا، والجولة الإرشادية كانت مذهلة بحق. شعرنا بالأمان والحماس طوال الوقت. معرفة الفريق عميقة وشغفهم بتاريخ مصر ينتقل إليك مباشرة."
                  : "Perfectly paced, and the guided tour was absolutely amazing. We felt safe and thrilled the entire time. The staff's knowledge is deep and their passion for Egyptian history is genuinely contagious."
                %>
              </p>
              <button class="review-link" type="button" aria-expanded="false"><%= isArabic ? "اقرأ المزيد" : "Read more" %></button>
            </div>
          </div>
        </article>

        <article class="reviews-slide">
          <div class="review-card">
            <div class="review-photo-banner" style="background-image:url('/assets/images/Christian%20bg.jpg')" role="img" aria-label="Ancient hieroglyphs"></div>
            <div class="review-avatar-wrap">
              <div class="review-avatar" style="background-image:url('/assets/images/image7.jpg')" role="img" aria-label="Omar's photo"></div>
            </div>
            <div class="review-body">
              <div class="review-name">Omar</div>
              <div class="review-meta">09 January 2023</div>
              <div class="review-stars" aria-label="5 stars">★★★★★</div>
              <div class="review-divider"></div>
              <p class="review-text">
                <%= isArabic
                  ? "بصفتي مصريا، تأثرت كثيرا برؤية تاريخنا يقدم بكل هذا الاهتمام والتقدير. عرض بمستوى عالمي، وإضاءة متقنة، ورحلة عبر الزمن لن أنساها أبدا."
                  : "As an Egyptian myself, I was moved to see our history presented with such care and reverence. World-class presentation, impeccable lighting, and a journey through time I will never forget."
                %>
              </p>
              <button class="review-link" type="button" aria-expanded="false"><%= isArabic ? "اقرأ المزيد" : "Read more" %></button>
            </div>
          </div>
        </article>
      </div>
    </div>
    <p class="reviews-pause-hint" id="pauseHint"><%= isArabic ? "انقر للإيقاف المؤقت ثم انقر مرة أخرى للاستئناف" : "Click to pause - Click again to resume" %></p>
  </div>
</section>

<script type="application/json" id="home-page-i18n"><%- JSON.stringify(homePageI18n) %></script>

<script src="/javascript/home.js"></script>

<script type="module" src="/vendor/model-viewer/model-viewer.min.js"></script>

<%- include('partials/footer') %>
