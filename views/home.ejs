<%- include('partials/header') %>
<%- include('partials/navbar') %>

<section class="hero hero--image">
  <div class="hero-overlay"></div>
  <div class="container hero-content">
    <div class="hero-copy">
      <p class="hero-kicker">The Afterlife Egyptian Museum</p>
      <h1>Discover Egypt's Timeless Legacy</h1>
      <p>Explore royal treasures, immersive virtual tours, and curated exhibits.</p>
      <div class="hero-actions">
        <a class="btn" href="/exhibits">Explore Exhibits</a>
        <a class="btn ghost" href="/virtual-tour">Start Virtual Tour</a>
      </div>
    </div>
    <div class="hero-media">
      <model-viewer
        class="hero-model"
        src="/assets/3dmodels/tutenkahmonhead.glb"
        alt="Tutankhamun head sculpture"
        camera-controls
        auto-rotate
        rotation-per-second="18deg"
        shadow-intensity="0.8"
        exposure="1.1"
        environment-image="neutral"
        disable-zoom
        interaction-prompt="none"
      ></model-viewer>
    </div>
  </div>
</section>

<section class="section weather-section">
  <div class="container">
    <div class="weather-panel">
      <div>
        <h3>Weather in Cairo</h3>
        <p class="weather-subtitle">Plan your visit with live conditions.</p>
      </div>
      <div class="weather-data">
        <%- weatherHtml %>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2>Featured Exhibits</h2>
    <div class="grid">
      <%- exhibitsHtml %>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2>Shop Highlights</h2>
    <div class="grid">
      <%- productsHtml %>
    </div>
  </div>
</section>

<section class="section alt">
  <div class="container">
    <h2>Visitor Testimonials</h2>
    <div class="grid">
      <%- testimonialsHtml %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
