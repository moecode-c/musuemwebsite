<%- include('partials/header') %>
<%- include('partials/navbar') %>

<section class="hero hero--image">
  <div class="hero-overlay"></div>

  <div class="container hero-content">
    <div class="hero-copy">
      <p class="hero-kicker"><%= t.hero.museumName %></p>
      <h1><%= t.hero.title %></h1>
      <p><%= t.hero.subtitle %></p>

      <div class="hero-actions">
        <a class="btn" href="/exhibits"><%= t.buttons.exploreExhibits %></a>
        <a class="btn ghost" href="/virtual-tour"><%= t.buttons.startVirtualTour %></a>
      </div>
    </div>

    <div class="hero-media">
      <model-viewer
        class="hero-model"
        src="/assets/3dmodels/tutenkahmonhead.glb"
        alt="Tutankhamun head sculpture"
        camera-controls
        auto-rotate
        rotation-per-second="18deg"
        shadow-intensity="0.8"
        exposure="1.1"
        environment-image="neutral"
        disable-zoom
        interaction-prompt="none"
      ></model-viewer>
    </div>
  </div>
</section>
<section class="section home-video">
  <div class="container home-video-grid">
    <div class="home-video-copy">
<p class="home-video-kicker"><%= t.home.spotlightKicker %></p>
<h2><%= t.home.spotlightTitle %></h2>
<p><%= t.home.spotlightText %></p>

<div class="home-video-actions">
  <a class="btn" href="/virtual-tour"><%= t.home.enterVirtualTour %></a>
  <span class="home-video-note"><%= t.home.autoPlaysNote %></span>
</div>
    </div>
    <div class="home-video-frame">
      <video
        class="home-video-media"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
      >
        <source src="/assets/videos/homepagevid.mp4" type="video/mp4" />
        Your browser does not support the video tag.
      </video>
      <div class="home-video-glow" aria-hidden="true"></div>
    </div>
  </div>
</section>

<section class="section weather-section">
  <div class="container">
    <div class="weather-panel">
      <div>
<h3><%= t.home.weatherTitle %></h3>
<p class="weather-subtitle"><%= t.home.weatherSubtitle %></p>
      </div>
      <div class="weather-data">
        <%- weatherHtml %>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
<h2><%= t.home.featuredExhibits %></h2>
    <div class="grid">
      <%- exhibitsHtml %>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
<h2><%= t.home.shopHighlights %></h2>
    <div class="grid">
      <%- productsHtml %>
    </div>
  </div>
</section>

<section class="section alt">
  <div class="container">
<h2><%= t.home.visitorTestimonials %></h2>
    <div class="grid">
      <%- testimonialsHtml %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
