<%- include('partials/header') %>
<%- include('partials/navbar') %>

<section class="page-hero">
  <div class="container">
    <h1>Plan Your Trip</h1>
    <p>Prepare your itinerary with tickets, timing, and travel tips.</p>
  </div>
</section>

<section class="section">
  <div class="container split">
    <div>
      <h2>Weather Update</h2>
      <%- weatherHtml %>
      <h2>Travel Tips</h2>
      <ul class="list">
        <li>Arrive early for guided tours.</li>
        <li>Book tickets online to skip the queue.</li>
        <li>Comfortable walking shoes recommended.</li>
      </ul>
    </div>
    <form class="form" id="trip-form">
      <label>Full Name</label>
      <input type="text" name="name" required />
      <label>Email</label>
      <input type="email" name="email" required />
      <label>Visit Date</label>
      <input type="date" name="date" required />
      <button class="btn" type="submit">Request Plan</button>
    </form>
  </div>
</section>

<%- include('partials/footer') %>
