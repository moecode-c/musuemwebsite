<%- include('../partials/adminLayoutStart') %>

<section class="admin-page-header">
  <div>
    <h1>Manage Map Pins</h1>
    <p>Place and edit pins on the museum map, then draw cleaning zones for staff tasks.</p>
  </div>
</section>

<section class="admin-section">
  <div class="admin-split">
    <div>
      <div class="map-wrapper admin-map" id="admin-map">
        <img src="/assets/map/map.png" alt="Museum map" class="map-image" />
        <div class="map-layer">
          <%- pinsHtml %>
        </div>
      </div>
      <p class="hint">Click on the map to add a pin.</p>
    </div>
    <div class="admin-panel">
      <form class="form" id="admin-map-form">
        <label>Label</label>
        <input type="text" name="label" required />
        <label>Description</label>
        <textarea name="description" required></textarea>
        <label>X (%)</label>
        <input type="number" name="x" min="0" max="100" step="any" required />
        <label>Y (%)</label>
        <input type="number" name="y" min="0" max="100" step="any" required />
        <label class="checkbox-row">
          <input type="checkbox" name="isCommon" />
          Mark as most common pin
        </label>
        <button class="btn admin-submit" type="submit">Create Pin</button>
        <button class="btn btn-secondary admin-cancel" type="button">Cancel</button>
        <p class="form-message" id="admin-map-message"></p>
      </form>

      <form class="form" id="admin-zone-form">
        <h3>Cleaning Zones</h3>
        <p class="admin-map-note">Click map points to build a polygon zone.</p>
        <label>Zone Name</label>
        <input type="text" name="zoneName" required />
        <label>Floor</label>
        <input type="text" name="floor" value="Ground" required />
        <label>Description</label>
        <textarea name="description"></textarea>
        <input type="hidden" name="polygon" />
        <div class="admin-actions">
          <button class="btn" type="submit">Create Zone</button>
          <button class="btn btn-secondary" type="button" id="admin-zone-clear-points">Clear Points</button>
        </div>
        <p class="form-message" id="admin-zone-message"></p>
      </form>

      <label>Assign Janitor</label>
      <select id="admin-zone-assign-user"></select>

      <div class="admin-map-lists">
        <h3>Most Common Pins</h3>
        <div id="admin-common-map-list" class="admin-list"></div>
        <h3>All Pins</h3>
        <div id="admin-map-list" class="admin-list"></div>
        <h3>Cleaning Zones</h3>
        <div id="admin-zone-list" class="admin-list"></div>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/adminLayoutEnd') %>
