<%- include('../partials/adminLayoutStart') %>

<section class="admin-page-header">
  <div>
    <h1>Manage Tickets</h1>
    <p>Update ticket pricing and types.</p>
  </div>
</section>

<section class="admin-section">
  <div class="admin-split">
    <form class="form" id="admin-ticket-form">
      <label>Category</label>
      <select name="group" required>
        <option value="egyptian">Egyptian</option>
        <option value="arab">Arab</option>
        <option value="foreigner">Foreigner</option>
      </select>
      <label>Audience</label>
      <select name="audience" required>
        <option value="adult">Adult</option>
        <option value="student">Student</option>
        <option value="child">Child</option>
        <option value="senior">Senior</option>
      </select>
      <label>Price</label>
      <input type="number" name="price" min="0" step="0.01" required />
      <label>Description</label>
      <textarea name="description"></textarea>
      <button class="btn admin-submit" type="submit">Create Ticket</button>
      <button class="btn btn-secondary admin-cancel" type="button">Cancel</button>
      <p class="form-message" id="admin-ticket-message"></p>
    </form>
    <div>
      <h3>Ticket List</h3>
      <div id="admin-ticket-list" class="admin-list"></div>
    </div>
  </div>
</section>

<%- include('../partials/adminLayoutEnd') %>
