<%- include('../partials/adminLayoutStart') %>

<section class="admin-page-header">
  <div>
    <h1><%= language === 'ar' ? 'إدارة المعروضات' : 'Manage Exhibits' %></h1>
    <p><%= language === 'ar' ? 'إضافة وتعديل وحذف معروضات المتحف.' : 'Add, edit, and remove museum exhibits.' %></p>
  </div>
</section>

<section class="admin-section">
  <div class="admin-split">
    <form class="form" id="admin-exhibit-form" autocomplete="off" enctype="multipart/form-data">
      <label><%= language === 'ar' ? 'العنوان' : 'Title' %></label>
      <input type="text" name="title" autocomplete="off" required />
      <label><%= language === 'ar' ? 'الفئة' : 'Category' %></label>
      <select name="category" required>
        <option value=""><%= language === 'ar' ? 'اختر نوع المعرض' : 'Select exhibit type' %></option>
        <option value="Pharaoh"><%= language === 'ar' ? 'فرعوني' : 'Pharaonic (Pharaoh)' %></option>
        <option value="Islamic"><%= language === 'ar' ? 'إسلامي' : 'Islamic' %></option>
        <option value="Christian"><%= language === 'ar' ? 'مسيحي' : 'Christian' %></option>
      </select>
      <p class="admin-map-note"><%= language === 'ar' ? 'اختيار النوع يحدد الصفحة التي سيظهر فيها المعروض: فرعوني أو إسلامي أو مسيحي.' : 'The selected type decides which collection page this exhibit appears in: Pharaoh, Islamic, or Christian.' %></p>
      <label><%= language === 'ar' ? 'الوصف' : 'Description' %></label>
      <textarea name="description" autocomplete="off" required></textarea>
      <label><%= language === 'ar' ? 'الحقبة' : 'Era' %></label>
      <input type="text" name="era" autocomplete="off" />
      <label><%= language === 'ar' ? 'الفترة' : 'Period' %></label>
      <input type="text" name="period" autocomplete="off" />
      <label><%= language === 'ar' ? 'الموقع' : 'Location' %></label>
      <input type="text" name="location" autocomplete="off" />
      <label>X (%)</label>
      <input type="number" name="x" autocomplete="off" min="0" max="100" step="any" />
      <label>Y (%)</label>
      <input type="number" name="y" autocomplete="off" min="0" max="100" step="any" />
      <div class="map-wrapper admin-exhibit-map" id="admin-exhibit-map">
        <img src="/assets/map/map.png" alt="<%= language === 'ar' ? 'خريطة المتحف' : 'Museum map' %>" class="map-image" />
        <div class="map-layer">
          <div class="map-pin map-pin-highlight" id="admin-exhibit-pin" style="display: none;"></div>
        </div>
      </div>
      <p class="admin-map-note"><%= language === 'ar' ? 'انقر على الخريطة لتحديد إحداثيات X/Y.' : 'Click the map to set X/Y coordinates.' %></p>
      <label><%= language === 'ar' ? 'الصورة' : 'Image' %></label>
      <input type="file" name="image" autocomplete="off" accept="image/*" required />
      <label><%= language === 'ar' ? 'نموذج ثلاثي الأبعاد (.glb/.gltf)' : '3D Model (.glb/.gltf)' %></label>
      <input type="file" name="model" autocomplete="off" accept=".glb,.gltf" required />
      <p class="admin-map-note"><%= language === 'ar' ? 'ارفع ملف .glb أو .gltf. مطلوب عند الإنشاء واختياري عند التعديل.' : 'Upload a .glb or .gltf model. Required when creating. Optional when editing.' %></p>
      <button class="btn admin-submit" type="submit"><%= language === 'ar' ? 'إنشاء معرض' : 'Create Exhibit' %></button>
      <button class="btn btn-secondary admin-cancel" type="button"><%= language === 'ar' ? 'إلغاء' : 'Cancel' %></button>
      <p class="form-message" id="admin-exhibit-message"></p>
    </form>
    <div>
      <h3><%= language === 'ar' ? 'قائمة المعروضات' : 'Exhibit List' %></h3>
      <div class="admin-list-toolbar" id="admin-exhibit-toolbar">
        <label for="admin-exhibit-filter-category"><%= language === 'ar' ? 'تصفية حسب النوع' : 'Filter by type' %></label>
        <div class="admin-list-toolbar-row">
          <select id="admin-exhibit-filter-category" aria-label="<%= language === 'ar' ? 'تصفية نوع المعرض' : 'Filter exhibit type' %>">
            <option value=""><%= language === 'ar' ? 'كل الأنواع' : 'All exhibit types' %></option>
            <option value="Pharaoh"><%= language === 'ar' ? 'فرعوني' : 'Pharaonic (Pharaoh)' %></option>
            <option value="Islamic"><%= language === 'ar' ? 'إسلامي' : 'Islamic' %></option>
            <option value="Christian"><%= language === 'ar' ? 'مسيحي' : 'Christian' %></option>
          </select>
          <input
            type="search"
            id="admin-exhibit-filter-search"
            autocomplete="off"
            placeholder="<%= language === 'ar' ? 'ابحث باسم المعرض أو الحقبة' : 'Search by exhibit title or era' %>"
            aria-label="<%= language === 'ar' ? 'بحث المعروضات' : 'Search exhibits' %>"
          />
        </div>
      </div>
      <div id="admin-exhibit-list" class="admin-list"></div>
    </div>
  </div>
</section>

<%- include('../partials/adminLayoutEnd') %>