<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<section class="page-hero">
  <div class="container">
    <h1>Manage Collections</h1>
    <p>Curate museum collections and categories.</p>
  </div>
</section>

<section class="section">
  <div class="container split">
    <form class="form" id="admin-collection-form" enctype="multipart/form-data">
      <label>Title</label>
      <input type="text" name="title" required />
      <label>Summary</label>
      <textarea name="summary" required></textarea>
      <label>Image</label>
      <input type="file" name="image" accept="image/*" required />
      <button class="btn" type="submit">Create Collection</button>
      <p class="form-message" id="admin-collection-message"></p>
    </form>
    <div>
      <h3>Collection List</h3>
      <div id="admin-collection-list" class="admin-list"></div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
