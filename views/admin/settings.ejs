<%- include('../partials/adminLayoutStart') %>

<section class="admin-page-header">
  <div>
    <h1>Settings</h1>
    <p>Configure site preferences and localization defaults.</p>
  </div>
</section>

<section class="admin-section">
  <div class="admin-panel">
    <form class="form" id="admin-settings-form">
      <label>Default Language</label>
      <select name="defaultLanguage">
        <option value="en">English</option>
        <option value="ar">Arabic</option>
      </select>
      <label>Contact Email</label>
      <input type="email" name="contactEmail" />
      <button class="btn" type="submit">Save Settings</button>
      <p class="form-message" id="admin-settings-message"></p>
    </form>
  </div>
</section>

<%- include('../partials/adminLayoutEnd') %>
