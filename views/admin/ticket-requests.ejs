<%- include('../partials/adminLayoutStart') %>

<section class="admin-page-header">
  <div>
    <h1><%= language === 'ar' ? 'نظرة عامة على التذاكر' : 'Ticket Overview' %></h1>
    <p><%= language === 'ar' ? 'مراجعة طلبات التذاكر وإحصائيات الزوار.' : 'Review ticket requests and visitor statistics.' %></p>
  </div>
</section>

<section class="admin-section">
  <div class="admin-section-title">
    <h2><%= language === 'ar' ? 'أكثر الدول زيارةً' : 'Top Countries' %></h2>
  </div>
  <div class="admin-chart">
    <% if (countries.length === 0) { %>
      <p><%= language === 'ar' ? 'لا توجد طلبات تذاكر بعد.' : 'No ticket requests yet.' %></p>
    <% } %>
    <% const maxCountry = Math.max(...countries.map((item) => item.count), 1); %>
    <% countries.forEach((item) => { %>
      <div class="admin-chart-row">
        <span><%= item.country %></span>
        <div class="admin-chart-bar"><span style="width: <%= (item.count / maxCountry) * 100 %>%"></span></div>
        <strong><%= item.count %></strong>
      </div>
    <% }) %>
  </div>
</section>

<section class="admin-section">
  <div class="admin-section-title">
    <h2><%= language === 'ar' ? 'جميع طلبات التذاكر' : 'All Ticket Requests' %></h2>
  </div>
  <div class="admin-toolbar">
    <input type="search" class="admin-search-input" id="ticketreq-search" placeholder="<%= language === 'ar' ? 'ابحث بالاسم أو البريد أو الجنسية...' : 'Search name, email, nationality...' %>" />
    <select class="admin-filter-select" id="ticketreq-status-filter">
      <option value=""><%= language === 'ar' ? 'كل الحالات' : 'All statuses' %></option>
      <option value="pending"><%= language === 'ar' ? 'قيد الانتظار' : 'Pending' %></option>
      <option value="accepted"><%= language === 'ar' ? 'مقبول' : 'Accepted' %></option>
      <option value="rejected"><%= language === 'ar' ? 'مرفوض' : 'Rejected' %></option>
    </select>
  </div>
  <p class="form-message" id="admin-ticketreq-message"></p>
  <div class="admin-orders" id="admin-ticketreq-list">
    <% if (requests.length === 0) { %>
      <p><%= language === 'ar' ? 'لا توجد طلبات بعد.' : 'No requests yet.' %></p>
    <% } %>
    <% requests.forEach((request) => { %>
      <% const st = request.status || 'pending'; %>
      <article class="admin-order-card" data-id="<%= request._id %>" data-status="<%= st %>">
        <div class="admin-order-head">
          <div>
            <strong><%= request.name %></strong>
            <span class="admin-order-date"><%= request.date %> · <%= request.timeSlot %></span>
          </div>
          <span class="admin-status-badge is-<%= st %>"><%= st %></span>
        </div>
        <div class="admin-order-body">
          <div class="admin-order-customer">
            <p class="muted"><%= request.email %><%= request.phone ? ' · ' + request.phone : '' %></p>
            <p class="muted"><%= language === 'ar' ? 'الجنسية' : 'Nationality' %>: <strong><%= request.nationality %></strong></p>
            <p class="muted"><%= language === 'ar' ? 'الفئة' : 'Category' %>: <%= request.category %> · <%= request.audience %> · <%= language === 'ar' ? 'الكمية' : 'Qty' %>: <%= request.quantity %></p>
          </div>
        </div>
        <div class="admin-order-actions">
          <button class="btn" data-ticketreq-action="accepted" data-id="<%= request._id %>" <%= st === 'accepted' ? 'disabled' : '' %>><%= language === 'ar' ? 'قبول التذكرة' : 'Accept' %></button>
          <button class="btn btn-secondary" data-ticketreq-action="rejected" data-id="<%= request._id %>" <%= st === 'rejected' ? 'disabled' : '' %>><%= language === 'ar' ? 'رفض' : 'Reject' %></button>
          <button class="btn btn-secondary" data-ticketreq-action="pending" data-id="<%= request._id %>" <%= st === 'pending' ? 'disabled' : '' %>><%= language === 'ar' ? 'قيد الانتظار' : 'Pending' %></button>
        </div>
      </article>
    <% }) %>
  </div>
</section>

<%- include('../partials/adminLayoutEnd') %>