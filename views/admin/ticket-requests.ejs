<%- include('../partials/adminLayoutStart') %>

<section class="admin-page-header">
  <div>
    <h1><%= language === 'ar' ? 'نظرة عامة على التذاكر' : 'Ticket Overview' %></h1>
    <p><%= language === 'ar' ? 'مراجعة طلبات التذاكر وإحصائيات الزوار.' : 'Review ticket requests and visitor statistics.' %></p>
  </div>
</section>

<section class="admin-section">
  <div class="admin-section-title">
    <h2><%= language === 'ar' ? 'أكثر الدول زيارةً' : 'Top Countries' %></h2>
  </div>
  <div class="admin-chart">
    <% if (countries.length === 0) { %>
      <p><%= language === 'ar' ? 'لا توجد طلبات تذاكر بعد.' : 'No ticket requests yet.' %></p>
    <% } %>
    <% const maxCountry = Math.max(...countries.map((item) => item.count), 1); %>
    <% countries.forEach((item) => { %>
      <div class="admin-chart-row">
        <span><%= item.country %></span>
        <div class="admin-chart-bar"><span style="width: <%= (item.count / maxCountry) * 100 %>%"></span></div>
        <strong><%= item.count %></strong>
      </div>
    <% }) %>
  </div>
</section>

<section class="admin-section">
  <div class="admin-section-title">
    <h2><%= language === 'ar' ? 'جميع طلبات التذاكر' : 'All Ticket Requests' %></h2>
  </div>
  <div class="admin-table">
    <div class="admin-table-row admin-table-head">
      <span><%= language === 'ar' ? 'الاسم' : 'Name' %></span>
      <span><%= language === 'ar' ? 'الجنسية' : 'Nationality' %></span>
      <span><%= language === 'ar' ? 'الفئة' : 'Category' %></span>
      <span><%= language === 'ar' ? 'الجمهور' : 'Audience' %></span>
      <span><%= language === 'ar' ? 'الكمية' : 'Qty' %></span>
      <span><%= language === 'ar' ? 'التاريخ' : 'Date' %></span>
      <span><%= language === 'ar' ? 'الفترة الزمنية' : 'Time Slot' %></span>
      <span><%= language === 'ar' ? 'التواصل' : 'Contact' %></span>
    </div>
    <% if (requests.length === 0) { %>
      <div class="admin-table-row">
        <span><%= language === 'ar' ? 'لا توجد طلبات بعد.' : 'No requests yet.' %></span>
      </div>
    <% } %>
    <% requests.forEach((request) => { %>
      <div class="admin-table-row">
        <span><%= request.name %></span>
        <span><%= request.nationality %></span>
        <span><%= request.category %></span>
        <span><%= request.audience %></span>
        <span><%= request.quantity %></span>
        <span><%= request.date %></span>
        <span><%= request.timeSlot %></span>
        <span><%= request.email %> | <%= request.phone %></span>
      </div>
    <% }) %>
  </div>
</section>

<%- include('../partials/adminLayoutEnd') %>