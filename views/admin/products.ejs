<%- include('../partials/adminLayoutStart') %>

<section class="admin-page-header">
  <div>
    <h1><%= language === 'ar' ? 'إدارة المنتجات' : 'Manage Products' %></h1>
    <p><%= language === 'ar' ? 'التحكم في عناصر المتجر والمخزون.' : 'Control shop items and inventory.' %></p>
  </div>
</section>

<section class="admin-section">
  <div class="admin-split">
    <form class="form" id="admin-product-form" autocomplete="off" enctype="multipart/form-data">
      <label><%= language === 'ar' ? 'الاسم' : 'Name' %></label>
      <input type="text" name="name" autocomplete="off" required />
      <label><%= language === 'ar' ? 'الوصف' : 'Description' %></label>
      <textarea name="description" autocomplete="off" required></textarea>
      <label><%= language === 'ar' ? 'السعر' : 'Price' %></label>
      <input type="number" name="price" autocomplete="off" min="0" step="0.01" required />
      <label><%= language === 'ar' ? 'المخزون' : 'Stock' %></label>
      <input type="number" name="stock" autocomplete="off" min="0" required />
      <label><%= language === 'ar' ? 'الصورة' : 'Image' %></label>
      <input type="file" name="image" autocomplete="off" accept="image/*" required />
      <button class="btn admin-submit" type="submit"><%= language === 'ar' ? 'إنشاء منتج' : 'Create Product' %></button>
      <button class="btn btn-secondary admin-cancel" type="button"><%= language === 'ar' ? 'إلغاء' : 'Cancel' %></button>
      <p class="form-message" id="admin-product-message"></p>
    </form>
    <div>
      <h3><%= language === 'ar' ? 'قائمة المنتجات' : 'Product List' %></h3>
      <div id="admin-product-list" class="admin-list"></div>
    </div>
  </div>
</section>

<%- include('../partials/adminLayoutEnd') %>