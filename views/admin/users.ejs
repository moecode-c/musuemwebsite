<%- include('../partials/adminLayoutStart') %>

<section class="admin-page-header">
  <div>
    <h1>Manage Users</h1>
    <p>Create admin accounts and manage roles.</p>
  </div>
</section>

<section class="admin-section">
  <div class="admin-split">
    <form class="form" id="admin-user-form">
      <label>Name</label>
      <input type="text" name="name" required />
      <label>Email</label>
      <input type="email" name="email" required />
      <label>Password</label>
      <input type="password" name="password" required />
      <label>Role</label>
      <select name="role">
        <option value="user">User</option>
        <option value="admin">Admin</option>
      </select>
      <button class="btn admin-submit" type="submit">Create User</button>
      <button class="btn btn-secondary admin-cancel" type="button">Cancel</button>
      <p class="form-message" id="admin-user-message"></p>
    </form>
    <div>
      <h3>User List</h3>
      <div id="admin-user-list" class="admin-list"></div>
    </div>
  </div>
</section>

<%- include('../partials/adminLayoutEnd') %>
