{
  "name": "egyptian-museum",
  "version": "1.0.0",
  "description": "Egyptian Museum web application (MVC, EJS, Express, MongoDB)",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "seed": "node seeders/seedAll.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --forceExit",
    "test:unit": "cross-env NODE_ENV=test jest --runInBand tests/unit",
    "test:integration": "cross-env NODE_ENV=test jest --runInBand --forceExit tests/integration",
    "test:smoke": "cross-env NODE_ENV=test jest --runInBand --forceExit tests/smoke",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --runInBand --forceExit --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@google/model-viewer": "^4.1.0",
    "bcrypt": "^5.1.1",
    "cloudinary": "^1.41.3",
    "compression": "^1.7.4",
    "connect-mongo": "^5.1.0",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-session": "^1.17.3",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "method-override": "^3.0.0",
    "mongoose": "^8.5.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.4",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.4.3",
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2"
  }
}
